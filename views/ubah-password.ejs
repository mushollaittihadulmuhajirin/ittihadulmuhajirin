<%- include("partials/header", { title: "Ubah Password & Kontak Pemulihan" }) %>
<%- include("partials/navbar") %>

<div class="container mt-4 mb-5">

    <!-- JUDUL HALAMAN -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-shield-lock text-success me-2"></i>Keamanan Akun &amp; Pemulihan
            </h3>
            <p class="text-muted small mb-0">
                Kelola kata sandi dan kontak darurat untuk fitur Lupa Password pengurus DKM Crystal (<strong class="text-dark"><%= username %></strong>)
            </p>
        </div>
        <a href="/dashboard" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Kembali ke Dashboard
        </a>
    </div>

    <!-- NOTIFIKASI GLOBAL -->
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Gagal:</strong> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Berhasil:</strong> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <div class="row g-4">

        <!-- KARTU 1: UBAH PASSWORD -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 16px; overflow: hidden;">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-key-fill"></i> Ubah Password Admin
                    </h5>
                    <small class="text-white-50">
                        Perbarui kata sandi secara berkala demi keamanan
                    </small>
                </div>

                <div class="card-body p-4">
                    <form id="formUbahPassword" action="/auth/ubah-password" method="POST">

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-secondary">
                                Password Lama
                            </label>
                            <input
                                type="password"
                                name="password_lama"
                                id="password_lama"
                                class="form-control"
                                placeholder="Masukkan password saat ini"
                                required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-secondary">
                                Password Baru
                            </label>
                            <input
                                type="password"
                                name="password_baru"
                                id="password_baru"
                                class="form-control"
                                placeholder="Minimal 6 karakter"
                                minlength="6"
                                required>
                            <div class="form-text text-muted" style="font-size: 0.75rem;">
                                Gunakan kombinasi huruf dan angka agar akun tetap aman.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-secondary">
                                Konfirmasi Password Baru
                            </label>
                            <input
                                type="password"
                                name="konfirmasi"
                                id="konfirmasi"
                                class="form-control"
                                placeholder="Ulangi password baru persis sama"
                                minlength="6"
                                required>
                        </div>

                        <div class="mb-4 form-check">
                            <input type="checkbox" class="form-check-input" id="showPasswordToggle">
                            <label class="form-check-label text-muted small" for="showPasswordToggle">
                                Tampilkan karakter password
                            </label>
                        </div>

                        <div class="pt-2">
                            <button type="submit" id="btnSubmitPassword" class="btn btn-success w-100 fw-bold py-2 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-check-circle"></i> Simpan Password Baru
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>

        <!-- KARTU 2: KONTAK PEMULIHAN (LUPA PASSWORD) -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 16px; overflow: hidden;">
                <div class="card-header bg-dark text-white py-3" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;">
                    <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success"></i> Kontak Pemulihan Akun
                    </h5>
                    <small class="text-white-50">
                        Digunakan saat pengurus lupa kata sandi login
                    </small>
                </div>

                <div class="card-body p-4">
                    <form id="formKontakPemulihan" action="/auth/kontak-pemulihan" method="POST">

                        <div class="p-3 bg-light rounded-3 border mb-3 small" style="line-height: 1.5; font-size: 0.8rem;">
                            <div class="fw-bold text-dark mb-1 d-flex align-items-center gap-1">
                                <i class="bi bi-info-circle text-primary"></i> Standar Pemulihan DKM Crystal:
                            </div>
                            Saat memilih <strong>Lupa Password?</strong> di halaman login, sistem akan mengirimkan tautan verifikasi ke email atau kode OTP ke WhatsApp sesuai data yang terdaftar di bawah ini.
                        </div>

                        <!-- INPUT EMAIL PEMULIHAN -->
                        <div class="mb-3">
                            <label for="recoveryEmail" class="form-label fw-semibold small text-secondary">
                                <i class="bi bi-envelope text-primary me-1"></i> Email Pemulihan Resmi
                            </label>
                            <input
                                type="email"
                                name="email"
                                id="recoveryEmail"
                                class="form-control"
                                placeholder="pengurus@masjid-muhajirin.id"
                                value="<%= typeof email !== 'undefined' ? email : '' %>">
                            <div class="form-text text-muted" style="font-size: 0.75rem;">
                                Digunakan untuk menerima tautan reset kata sandi (berlaku 15 menit).
                            </div>
                        </div>

                        <!-- INPUT WHATSAPP PEMULIHAN -->
                        <div class="mb-4">
                            <label for="recoveryPhone" class="form-label fw-semibold small text-secondary">
                                <i class="bi bi-whatsapp text-success me-1"></i> Nomor WhatsApp / HP Pemulihan
                            </label>
                            <input
                                type="tel"
                                name="no_hp"
                                id="recoveryPhone"
                                class="form-control"
                                placeholder="081234567890 atau +6281234567890"
                                value="<%= typeof no_hp !== 'undefined' ? no_hp : '' %>">
                            <div class="form-text text-muted" style="font-size: 0.75rem;">
                                Digunakan untuk menerima 6-digit kode OTP sekali pakai via WhatsApp.
                            </div>
                        </div>

                        <div class="pt-2">
                            <button type="submit" id="btnSubmitKontak" class="btn btn-outline-success w-100 fw-bold py-2 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-save"></i> Simpan Kontak Pemulihan
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>

    </div>

</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const toggle = document.getElementById("showPasswordToggle");
    const pLama = document.getElementById("password_lama");
    const pBaru = document.getElementById("password_baru");
    const pKonf = document.getElementById("konfirmasi");
    const formPwd = document.getElementById("formUbahPassword");

    if (toggle) {
        toggle.addEventListener("change", function() {
            const type = this.checked ? "text" : "password";
            if (pLama) pLama.type = type;
            if (pBaru) pBaru.type = type;
            if (pKonf) pKonf.type = type;
        });
    }

    if (formPwd) {
        formPwd.addEventListener("submit", function(e) {
            const valBaru = (pBaru ? pBaru.value : "").trim();
            const valKonf = (pKonf ? pKonf.value : "").trim();

            if (valBaru.length < 6) {
                e.preventDefault();
                alert("Password baru harus minimal 6 karakter.");
                pBaru.focus();
                return false;
            }

            if (valBaru !== valKonf) {
                e.preventDefault();
                alert("Konfirmasi password baru tidak cocok dengan password baru.");
                pKonf.focus();
                return false;
            }
        });
    }
});
</script>

<%- include("partials/footer") %>