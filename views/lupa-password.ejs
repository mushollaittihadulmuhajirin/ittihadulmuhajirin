<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons 1.11.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Dedicated Admin Stylesheet -->
    <link rel="stylesheet" href="/css/admin.css">

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body.recovery-page {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #064e3b 0%, #0f172a 100%);
            margin: 0;
            padding: 0;
            width: 100%;
            overflow-x: hidden;
        }

        .recovery-card {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border-radius: 18px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin: 0 auto;
        }

        .recovery-header {
            background: linear-gradient(135deg, #065f46 0%, #047857 100%);
            color: #ffffff;
            padding: 26px 20px;
            text-align: center;
        }

        .recovery-logo-container {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 76px;
            height: 76px;
            background: #0f172a;
            border: 2px solid rgba(255, 255, 255, 0.25);
            border-radius: 18px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
            margin-bottom: 14px;
            padding: 6px;
            overflow: hidden;
        }

        .recovery-logo-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .recovery-title {
            font-size: 1.35rem;
            font-weight: 700;
            margin: 0;
            letter-spacing: -0.01em;
        }

        .recovery-subtitle {
            font-size: 0.8125rem;
            color: rgba(255, 255, 255, 0.85);
            margin-top: 6px;
            line-height: 1.45;
            padding: 0 8px;
        }

        .recovery-body {
            padding: 28px 24px;
        }

        @media (max-width: 480px) {
            .recovery-body {
                padding: 22px 18px;
            }
            .recovery-header {
                padding: 22px 16px;
            }
        }

        .method-selector-card {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 12px;
            background: #ffffff;
            user-select: none;
        }

        .method-selector-card:hover {
            border-color: #a7f3d0;
            background-color: #f0fdf4;
        }

        .method-selector-card.active {
            border-color: #059669;
            background-color: #ecfdf5;
            box-shadow: 0 0 0 1px #059669;
        }

        .method-icon-circle {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
            background: #f1f5f9;
            color: #475569;
            transition: all 0.2s ease;
        }

        .method-selector-card.active .method-icon-circle {
            background: #059669;
            color: #ffffff;
        }

        .recovery-btn {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            border: none;
            color: #ffffff;
            font-weight: 600;
            padding: 12px;
            border-radius: 10px;
            transition: all 0.2s ease;
        }

        .recovery-btn:hover {
            background: linear-gradient(135deg, #047857 0%, #065f46 100%);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.35);
            transform: translateY(-1px);
        }

        .recovery-footer-links {
            text-align: center;
            padding: 16px 24px 24px;
            border-top: 1px solid #f1f5f9;
        }
    </style>
</head>
<body class="recovery-page">

<div class="container d-flex align-items-center justify-content-center min-vh-100 py-3 px-3">
    <div class="recovery-card">
        
        <div class="recovery-header">
            <div class="recovery-logo-container">
                <img 
                    src="/images/hero/logo-dkm-muhajirin.png" 
                    alt="Logo Masjid Ittihadul Muhajirin" 
                    class="recovery-logo-img">
            </div>
            <h2 class="recovery-title">Lupa Password?</h2>
            <div class="recovery-subtitle">
                Pilih metode pemulihan untuk mendapatkan kode atau tautan verifikasi.
            </div>
        </div>

        <div class="recovery-body">
            
            <% if (error) { %>
                <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3 rounded-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
                    <div><%= error %></div>
                </div>
            <% } %>

            <% if (success) { %>
                <div class="alert alert-success py-2 px-3 small d-flex align-items-center gap-2 mb-3 rounded-3" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 flex-shrink-0 text-success"></i>
                    <div><%= success %></div>
                </div>
            <% } %>

            <% if (neutralNotice) { %>
                <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3 rounded-3 border-info-subtle" role="alert">
                    <i class="bi bi-info-circle-fill fs-5 flex-shrink-0 text-primary"></i>
                    <div><%= neutralNotice %></div>
                </div>
            <% } %>

            <% if (devData && devData.resetUrl) { %>
                <div class="alert alert-warning py-2 px-3 small mb-3 rounded-3 border-warning">
                    <div class="fw-bold mb-1"><i class="bi bi-cone-striped"></i> Simulasi Pengujian Lokal:</div>
                    <div class="text-break mb-1">Tautan reset: <a href="<%= devData.resetUrl %>" class="fw-semibold text-dark"><%= devData.resetUrl %></a></div>
                    <div class="small text-muted">(Token tidak dikirim ke internet, dicatat aman untuk uji lokal)</div>
                </div>
            <% } %>

            <form method="POST" action="/lupa-password" id="recoveryForm">
                
                <!-- PILIHAN METODE -->
                <label class="form-label small fw-semibold text-secondary mb-2">Metode Pemulihan</label>
                <div class="row g-2 mb-3">
                    
                    <!-- OPSI 1: EMAIL -->
                    <div class="col-6">
                        <label class="method-selector-card <%= method === 'email' ? 'active' : '' %>" id="cardMethodEmail">
                            <input 
                                type="radio" 
                                name="metode" 
                                value="email" 
                                class="d-none" 
                                <%= method === 'email' ? 'checked' : '' %>>
                            <div class="method-icon-circle">
                                <i class="bi bi-envelope-at"></i>
                            </div>
                            <div>
                                <div class="fw-bold small text-dark">Email</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Tautan reset</div>
                            </div>
                        </label>
                    </div>

                    <!-- OPSI 2: NOMOR HP / WHATSAPP -->
                    <div class="col-6">
                        <label class="method-selector-card <%= method === 'no_hp' ? 'active' : '' %>" id="cardMethodPhone">
                            <input 
                                type="radio" 
                                name="metode" 
                                value="no_hp" 
                                class="d-none" 
                                <%= method === 'no_hp' ? 'checked' : '' %>>
                            <div class="method-icon-circle">
                                <i class="bi bi-whatsapp text-success"></i>
                            </div>
                            <div>
                                <div class="fw-bold small text-dark">Nomor HP</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Kode OTP WhatsApp</div>
                            </div>
                        </label>
                    </div>

                </div>

                <!-- KOLOM EMAIL (DITAMPILKAN JIKA EMAIL DIPILIH) -->
                <div class="mb-4 <%= method === 'no_hp' ? 'd-none' : '' %>" id="sectionInputEmail">
                    <label for="inputEmail" class="form-label small fw-semibold text-secondary">Alamat Email Terdaftar</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input
                            type="email"
                            name="identifier_email"
                            id="inputEmail"
                            class="form-control border-start-0"
                            placeholder="nama@masjid-muhajirin.id"
                            value="<%= method === 'email' && typeof inputVal !== 'undefined' ? inputVal : '' %>"
                            <%= method === 'email' ? 'required' : '' %>>
                    </div>
                    <div class="form-text small text-muted mt-1" style="font-size: 0.725rem;">
                        Tautan pemulihan akan dikirimkan jika email telah diverifikasi di sistem.
                    </div>
                </div>

                <!-- KOLOM NOMOR HP (DITAMPILKAN JIKA NOMOR HP DIPILIH) -->
                <div class="mb-4 <%= method === 'email' ? 'd-none' : '' %>" id="sectionInputPhone">
                    <label for="inputPhone" class="form-label small fw-semibold text-secondary">Nomor WhatsApp / HP Terdaftar</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-success fw-bold border-end-0">
                            +62
                        </span>
                        <input
                            type="tel"
                            name="identifier_phone"
                            id="inputPhone"
                            class="form-control border-start-0"
                            placeholder="812-3456-7890"
                            value="<%= method === 'no_hp' && typeof inputVal !== 'undefined' ? inputVal : '' %>"
                            <%= method === 'no_hp' ? 'required' : '' %>>
                    </div>
                    <div class="form-text small text-muted mt-1" style="font-size: 0.725rem;">
                        Format nomor Indonesia (+62). Kode verifikasi OTP akan dikirimkan ke WhatsApp Anda.
                    </div>
                </div>

                <!-- HIDDEN IDENTIFIER YANG DIKIRIM KE BACKEND -->
                <input type="hidden" name="identifier" id="hiddenIdentifier" value="">

                <!-- TOMBOL LANJUTKAN -->
                <button type="submit" class="btn recovery-btn w-100 d-flex align-items-center justify-content-center gap-2 mb-3">
                    <i class="bi bi-arrow-right-circle fs-5"></i>
                    <span>Lanjutkan</span>
                </button>

                <!-- PETUNJUK ADMINISTRATOR JIKA BELUM TERDAFTAR -->
                <div class="p-3 bg-light rounded-3 border text-secondary small" style="font-size: 0.75rem; line-height: 1.45;">
                    <div class="fw-bold text-dark mb-1"><i class="bi bi-shield-lock-fill text-success"></i> Informasi Akun Admin:</div>
                    Jika Anda belum mendaftarkan email atau nomor WhatsApp pemulihan melalui panel admin terautentikasi, silakan hubungi <strong>Administrator Utama DKM</strong> untuk bantuan pengaturan ulang secara langsung.
                </div>

            </form>
        </div>

        <div class="recovery-footer-links">
            <a href="/login" class="text-decoration-none small text-muted d-inline-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Kembali ke Login
            </a>
        </div>

    </div>
</div>

<script>
    const cardEmail = document.getElementById("cardMethodEmail");
    const cardPhone = document.getElementById("cardMethodPhone");
    const radioEmail = cardEmail.querySelector("input[type=radio]");
    const radioPhone = cardPhone.querySelector("input[type=radio]");
    const secEmail = document.getElementById("sectionInputEmail");
    const secPhone = document.getElementById("sectionInputPhone");
    const inputEmail = document.getElementById("inputEmail");
    const inputPhone = document.getElementById("inputPhone");
    const form = document.getElementById("recoveryForm");
    const hiddenIden = document.getElementById("hiddenIdentifier");

    function updateMethod(isEmail) {
        if (isEmail) {
            cardEmail.classList.add("active");
            cardPhone.classList.remove("active");
            radioEmail.checked = true;
            secEmail.classList.remove("d-none");
            secPhone.classList.add("d-none");
            inputEmail.required = true;
            inputPhone.required = false;
            inputEmail.focus();
        } else {
            cardPhone.classList.add("active");
            cardEmail.classList.remove("active");
            radioPhone.checked = true;
            secPhone.classList.remove("d-none");
            secEmail.classList.add("d-none");
            inputPhone.required = true;
            inputEmail.required = false;
            inputPhone.focus();
        }
    }

    cardEmail.addEventListener("click", () => updateMethod(true));
    cardPhone.addEventListener("click", () => updateMethod(false));

    form.addEventListener("submit", function(e) {
        if (radioEmail.checked) {
            hiddenIden.value = inputEmail.value.trim();
        } else {
            let phoneVal = inputPhone.value.trim();
            if (!phoneVal.startsWith("+62") && !phoneVal.startsWith("62") && !phoneVal.startsWith("0")) {
                phoneVal = "+62" + phoneVal;
            }
            hiddenIden.value = phoneVal;
        }
    });
</script>

</body>
</html>

