<%- include("../partials/header", { title: "Edit Donasi Barang — DKM Crystal" }) %>
<%- include("../partials/navbar") %>

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">
            <i class="bi bi-pencil-square text-warning"></i> Edit Donasi Barang
        </h1>
        <div class="admin-page-subtitle">
            <span>Perbarui data sumbangan/donasi barang fisik dari warga</span>
        </div>
    </div>
    <div>
        <a href="/transaksi" class="admin-btn admin-btn-secondary">
            <i class="bi bi-arrow-left"></i> Kembali ke Transaksi
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header bg-dark text-white">
                <h5><i class="bi bi-gift text-warning"></i> Formulir Perubahan Donasi Barang #<%= data.id %></h5>
            </div>
            <div class="admin-card-body p-4">
                <form action="/transaksi/update-donasi/<%= data.id %>" method="POST">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="admin-form-label">Tanggal Penerimaan <span class="text-danger">*</span></label>
                            <input
                                type="date"
                                name="tanggal"
                                class="admin-form-control"
                                value="<%= new Date(data.tanggal).toISOString().slice(0,10) %>"
                                required>
                        </div>

                        <div class="col-md-8">
                            <label class="admin-form-label">Nama Donatur / Jamaah <span class="text-danger">*</span></label>
                            <input
                                type="text"
                                name="nama_donatur"
                                class="admin-form-control"
                                value="<%= data.nama_donatur %>"
                                required>
                        </div>

                        <div class="col-md-6">
                            <label class="admin-form-label">Nama Barang / Deskripsi <span class="text-danger">*</span></label>
                            <input
                                type="text"
                                name="nama_barang"
                                class="admin-form-control"
                                value="<%= data.nama_barang %>"
                                required>
                        </div>

                        <div class="col-md-6">
                            <label class="admin-form-label">Kategori Barang</label>
                            <select name="kategori" class="admin-form-select">
                                <% kategori.forEach(function(k) { %>
                                    <option value="<%= k.nama %>" <%= data.kategori == k.nama ? "selected" : "" %>>
                                        <%= k.nama %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="admin-form-label">Jumlah / Qty</label>
                            <input
                                type="number"
                                name="jumlah"
                                class="admin-form-control font-monospace"
                                value="<%= data.jumlah %>">
                        </div>

                        <div class="col-md-3">
                            <label class="admin-form-label">Satuan</label>
                            <input
                                type="text"
                                name="satuan"
                                class="admin-form-control"
                                placeholder="Pcs, Unit, Dus"
                                value="<%= data.satuan %>">
                        </div>

                        <div class="col-md-3">
                            <label class="admin-form-label">Kondisi</label>
                            <select name="kondisi" class="admin-form-select">
                                <option value="Baru" <%= data.kondisi == "Baru" ? "selected" : "" %>>Baru</option>
                                <option value="Bekas" <%= data.kondisi == "Bekas" ? "selected" : "" %>>Bekas</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="admin-form-label">Estimasi Harga (Rp)</label>
                            <input
                                type="number"
                                name="estimasi_harga"
                                class="admin-form-control font-monospace"
                                value="<%= data.estimasi_harga %>">
                        </div>

                        <div class="col-12">
                            <label class="admin-form-label">Keterangan Tambahan</label>
                            <textarea
                                name="keterangan"
                                class="admin-form-control"
                                rows="3"
                                placeholder="Catatan atau riwayat penyerahan donasi"><%= data.keterangan %></textarea>
                        </div>

                        <div class="col-12 d-flex justify-content-between pt-2">
                            <a href="/transaksi" class="admin-btn admin-btn-secondary">
                                <i class="bi bi-x-circle"></i> Batal
                            </a>
                            <button type="submit" class="admin-btn admin-btn-primary px-4">
                                <i class="bi bi-save2"></i> Simpan Perubahan
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include("../partials/footer") %>