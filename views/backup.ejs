<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div class="container py-4">

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
            <h3 class="fw-bold text-success mb-1">
                <i class="bi bi-database-down me-2"></i>Backup Database DKM
            </h3>
            <p class="text-muted small mb-0">
                Pencadangan database manual langsung ke perangkat admin &amp; informasi auto-backup infrastruktur cloud.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill small">
                <i class="bi bi-database me-1"></i> Database: <strong><%= typeof dbName !== 'undefined' ? dbName : 'dkm_crystal' %></strong>
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Kolom Kiri: Backup Manual Admin (Unduh ke Perangkat) -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-success text-white py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-cloud-arrow-down-fill me-2"></i>Backup Database Manual (Unduh ke Perangkat)
                    </h5>
                    <span class="badge bg-light text-success fw-bold">Manual Download</span>
                </div>
                <div class="card-body p-4">
                    <p class="text-secondary mb-3">
                        Klik tombol di bawah ini untuk mencadangkan seluruh data operasional masjid (transaksi kas/bank, donasi barang, master aset inventaris, saran warga, master blok, kategori, dan rekening) ke dalam berkas standar <code>.sql</code> yang langsung disimpan di perangkat komputer, laptop, atau handphone Anda.
                    </p>

                    <!-- Action Button & Status Container -->
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <button
                                id="btnBackup"
                                class="btn btn-success btn-lg fw-bold px-4 py-2 shadow-sm d-inline-flex align-items-center gap-2">
                                <i class="bi bi-download fs-5"></i>
                                <span>Backup Database</span>
                            </button>

                            <a
                                href="/backup/download-direct"
                                id="linkDirectDownload"
                                class="btn btn-outline-secondary btn-sm"
                                title="Gunakan ini jika unduhan otomatis terblokir browser">
                                <i class="bi bi-box-arrow-down me-1"></i> Unduh Langsung via HTTP
                            </a>
                        </div>

                        <!-- Live Status Area (Hanya muncul jika dieksekusi) -->
                        <div id="backupAlertArea"></div>
                    </div>

                    <!-- Ketentuan & Panduan Penyimpanan -->
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100 bg-white">
                                <div class="fw-bold text-success mb-1 small">
                                    <i class="bi bi-laptop me-1"></i> Pada Komputer / Laptop (PC)
                                </div>
                                <div class="text-muted small">
                                    Berkas otomatis tersimpan di folder <strong>Downloads</strong> atau membuka jendela <em>"Save As"</em> sesuai pengaturan browser Anda.
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100 bg-white">
                                <div class="fw-bold text-success mb-1 small">
                                    <i class="bi bi-phone me-1"></i> Pada Smartphone / HP (Android / iOS)
                                </div>
                                <div class="text-muted small">
                                    Notifikasi unduhan muncul di layar dan berkas <code>.sql</code> tersimpan aman pada folder <strong>Unduhan (Downloads)</strong> perangkat Anda.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 small text-muted">
                        <i class="bi bi-shield-check text-success me-1"></i>
                        Berkas hasil cadangan dapat langsung dipulihkan sewaktu-waktu melalui menu <a href="/restore" class="fw-bold text-success text-decoration-underline">Restore Database</a>.
                    </div>
                </div>
            </div>

            <!-- Card 2: Riwayat Sesi Sementara di Server (Opsional) -->
            <div class="card shadow-sm border-0 rounded-3 mt-4">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-folder2-open me-2 text-warning"></i>Berkas Sesi Sementara Server
                    </h6>
                    <button
                        class="btn btn-outline-success btn-sm"
                        onclick="loadBackupList()">
                        <i class="bi bi-arrow-clockwise"></i> Perbarui
                    </button>
                </div>
                <div class="card-body p-4">
                    <div class="small text-muted mb-3">
                        Daftar file yang baru saja diproses dalam sesi server saat ini. File manual utama telah diunduh ke perangkat Anda dan tidak disimpan permanen di server demi efisiensi dan keamanan.
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Nama Berkas (.sql)</th>
                                    <th>Ukuran</th>
                                    <th>Waktu Dibuat</th>
                                    <th width="140" class="text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="backupTable">
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">
                                        Memuat riwayat sesi...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Kolom Kanan: Auto-Backup TiDB Cloud Info & Perbandingan -->
        <div class="col-lg-4">
            <!-- Card 3: Auto-Backup TiDB Cloud Info -->
            <div class="card shadow-sm border-0 rounded-3 mb-4 border-top border-4 border-info">
                <div class="card-header bg-white py-3 px-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock-fill text-info fs-5"></i>
                        <span>Auto-Backup TiDB Cloud</span>
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="badge bg-info-subtle text-info-emphasis border border-info-subtle mb-2 px-2 py-1">
                        Infrastruktur Cloud Terkelola
                    </div>
                    <p class="small text-secondary mb-2">
                        TiDB Cloud Serverless mengelola snapshot dan pencadangan otomatis (Auto-Backup) pada level penyimpanan terdistribusi (TiKV).
                    </p>
                    <ul class="list-unstyled small text-muted mb-3 d-flex flex-column gap-2">
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle-fill text-success mt-1"></i>
                            <span><strong>Jadwal &amp; Retensi:</strong> Berjalan otomatis mengikuti kebijakan SLA TiDB Cloud tanpa intervensi manual.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle-fill text-success mt-1"></i>
                            <span><strong>Perlindungan Bencana:</strong> Menjamin pemulihan basis data jika terjadi kegagalan infrastruktur fisik cloud.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-lock-fill text-primary mt-1"></i>
                            <span><strong>Terpisah &amp; Aman:</strong> Backup manual admin pada halaman ini tidak mengubah konfigurasi auto-backup TiDB Cloud.</span>
                        </li>
                    </ul>
                    <div class="alert alert-light border small text-muted mb-0 py-2">
                        <i class="bi bi-info-circle text-primary me-1"></i>
                        Status auto-backup TiDB Cloud dikelola langsung oleh platform PingCAP TiDB Cloud.
                    </div>
                </div>
            </div>

            <!-- Card 4: Ringkasan Perbedaan Dua Mekanisme -->
            <div class="card shadow-sm border-0 rounded-3 bg-light">
                <div class="card-body p-3">
                    <h6 class="fw-bold text-dark small mb-2">
                        <i class="bi bi-diagram-3 me-1 text-success"></i> Perbandingan Mekanisme Backup
                    </h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless small mb-0">
                            <tbody>
                                <tr class="border-bottom">
                                    <td class="text-muted py-2" width="40%">Fitur</td>
                                    <td class="fw-bold text-success py-2">Manual Admin</td>
                                    <td class="fw-bold text-info py-2">Auto TiDB</td>
                                </tr>
                                <tr class="border-bottom">
                                    <td class="text-muted py-2">Pemicu</td>
                                    <td class="py-2">Tombol Admin</td>
                                    <td class="py-2">Sistem TiDB</td>
                                </tr>
                                <tr class="border-bottom">
                                    <td class="text-muted py-2">Lokasi</td>
                                    <td class="py-2">Perangkat Pribadi</td>
                                    <td class="py-2">Storage TiDB</td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-2">Format</td>
                                    <td class="py-2">Berkas .SQL</td>
                                    <td class="py-2">Snapshot TiKV</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
const btn = document.getElementById("btnBackup");
const alertArea = document.getElementById("backupAlertArea");
const table = document.getElementById("backupTable");

// =======================
// EKSEKUSI & UNDUH BACKUP MANUAL KE PERANGKAT
// =======================
btn.addEventListener("click", async () => {
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Memproses Backup...';

    alertArea.innerHTML = `
        <div class="alert alert-info d-flex align-items-center gap-2 mt-3 mb-0 py-2 shadow-sm">
            <span class="spinner-border spinner-border-sm text-primary"></span>
            <span>Sedang memproses dump database dan menyiapkan file unduhan... Mohon tunggu sebentar.</span>
        </div>
    `;

    try {
        const response = await fetch("/backup/download" + window.location.search, {
            method: "POST",
            headers: {
                "Accept": "application/sql, application/json"
            }
        });

        if (!response.ok) {
            let errorMsg = `Gagal membuat backup (HTTP ${response.status})`;
            try {
                const errJson = await response.json();
                if (errJson && errJson.message) errorMsg = errJson.message;
            } catch (_) {}
            throw new Error(errorMsg);
        }

        // Ambil nama file dari header Content-Disposition atau header fallback
        const disposition = response.headers.get("Content-Disposition") || "";
        let fileName = "backup-dkm.sql";
        const filenameMatch = disposition.match(/filename=["']?([^"';]+)["']?/i);
        if (filenameMatch && filenameMatch[1]) {
            fileName = filenameMatch[1];
        } else if (response.headers.get("X-Backup-Filename")) {
            fileName = response.headers.get("X-Backup-Filename");
        }

        // Ambil data Blob SQL
        const blob = await response.blob();
        if (blob.size === 0) {
            throw new Error("File backup yang diterima kosong (0 bytes).");
        }

        const sizeFormatted = blob.size > 1024 * 1024
            ? (blob.size / (1024 * 1024)).toFixed(2) + " MB"
            : Math.round(blob.size / 1024) + " KB";

        // Memicu unduhan pada browser PC/Laptop maupun HP
        const blobUrl = window.URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.style.display = "none";
        a.href = blobUrl;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();

        setTimeout(() => {
            if (a.parentNode) document.body.removeChild(a);
            window.URL.revokeObjectURL(blobUrl);
        }, 2000);

        // Tampilkan pesan sukses hanya setelah pengiriman & pembuatan berhasil
        alertArea.innerHTML = `
            <div class="alert alert-success mt-3 mb-0 py-3 shadow-sm border-success">
                <div class="d-flex align-items-center gap-2 fw-bold text-success fs-6">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <span>Backup Database Berhasil Diunduh!</span>
                </div>
                <div class="mt-2 text-dark small">
                    <div>Berkas: <code class="fw-bold text-dark bg-white px-2 py-1 rounded border">${fileName}</code> (${sizeFormatted})</div>
                    <div class="mt-1 text-muted">
                        <i class="bi bi-info-circle"></i> Berkas telah disimpan di perangkat Anda sesuai folder unduhan browser. Berkas ini siap dipulihkan kapan saja melalui menu <a href="/restore" class="text-success fw-bold text-decoration-underline">Restore Database</a>.
                    </div>
                </div>
            </div>
        `;

        // Refresh tabel sesi sementara
        loadBackupList();

    } catch (err) {
        console.error("Backup error:", err);
        alertArea.innerHTML = `
            <div class="alert alert-danger d-flex align-items-center gap-2 mt-3 mb-0 py-2 shadow-sm">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div>
                    <strong>Gagal membuat backup:</strong> ${err.message}<br>
                    <small>Silakan coba kembali atau gunakan <a href="/backup/download-direct" class="text-danger fw-bold text-decoration-underline">Tautan Unduh Langsung</a>.</small>
                </div>
            </div>
        `;
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-download fs-5"></i> <span>Backup Database</span>';
    }
});

// =======================
// LOAD LIST BACKUP SEMENTARA
// =======================
async function loadBackupList() {
    if (!table) return;

    table.innerHTML = `
        <tr>
            <td colspan="4" class="text-center text-muted py-3">
                <span class="spinner-border spinner-border-sm me-2"></span> Memuat data sesi...
            </td>
        </tr>
    `;

    try {
        const response = await fetch("/backup/list" + window.location.search);
        const result = await response.json();

        if (!result.success) {
            table.innerHTML = `
                <tr>
                    <td colspan="4" class="text-danger text-center py-3">
                        ❌ ${result.message}
                    </td>
                </tr>
            `;
            return;
        }

        if (!result.files || result.files.length === 0) {
            table.innerHTML = `
                <tr>
                    <td colspan="4" class="text-center text-muted py-3">
                        Belum ada berkas backup pada sesi server ini. Klik tombol <strong>Backup Database</strong> untuk membuat dan mengunduh berkas baru.
                    </td>
                </tr>
            `;
            return;
        }

        table.innerHTML = "";

        result.files.forEach(file => {
            const rawSize = file.metadata && file.metadata.size ? file.metadata.size : 0;
            const size = rawSize > 0
                ? (rawSize > 1024 * 1024 ? (rawSize / (1024 * 1024)).toFixed(2) + " MB" : Math.round(rawSize / 1024) + " KB")
                : "-";

            const created = file.created_at ? new Date(file.created_at).toLocaleString("id-ID") : "-";

            table.innerHTML += `
                <tr>
                    <td><code>${file.name}</code></td>
                    <td>${size}</td>
                    <td>${created}</td>
                    <td class="text-center">
                        <a
                            class="btn btn-outline-primary btn-sm py-1 px-2"
                            href="/backup/download/${encodeURIComponent(file.name)}"
                            download="${file.name}">
                            <i class="bi bi-download me-1"></i> Unduh
                        </a>
                    </td>
                </tr>
            `;
        });

    } catch (err) {
        table.innerHTML = `
            <tr>
                <td colspan="4" class="text-danger text-center py-3">
                    ❌ ${err.message}
                </td>
            </tr>
        `;
    }
}

// Muat riwayat sesi saat halaman dibuka
loadBackupList();
</script>

<%- include("partials/footer") %>