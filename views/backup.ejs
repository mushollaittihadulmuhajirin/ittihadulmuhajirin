<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">

            <div class="d-flex align-items-center gap-2">
                <h4 class="mb-0">💾 Backup Database</h4>
                <span class="badge bg-light text-dark border ms-2">
                    Database: <%= typeof dbName !== 'undefined' ? dbName : 'dkm_crystal_local_test' %>
                </span>
            </div>

            <button
                class="btn btn-light btn-sm"
                onclick="loadBackupList()">
                🔄 Refresh
            </button>

        </div>

        <div class="card-body">

            <p class="text-muted">
                Cadangkan seluruh struktur dan data database DKM Crystal (transaksi, donasi barang, inventaris aset, master blok, saran warga, kategori, dan rekening).
            </p>

            <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                <button
                    id="btnBackup"
                    class="btn btn-success fw-semibold">
                    💾 Buat Backup Sekarang
                </button>

                <span
                    id="backupStatus"
                    class="ms-2 fw-bold">
                </span>
            </div>

            <hr>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">📁 Riwayat Berkas Backup</h5>
                <small class="text-muted">Tersimpan di direktori lokal &amp; cloud storage</small>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>Nama File</th>

                            <th>Ukuran</th>

                            <th>Penyimpanan</th>

                            <th>Waktu Pembuatan</th>

                            <th width="160" class="text-center">Aksi</th>

                        </tr>

                    </thead>

                    <tbody id="backupTable">

                        <tr>

                            <td colspan="5" class="text-center text-muted py-4">

                                Memuat daftar backup...

                            </td>

                        </tr>

                    </tbody>

                </table>
            </div>

        </div>

    </div>

</div>

<script>

const btn = document.getElementById("btnBackup");
const status = document.getElementById("backupStatus");
const table = document.getElementById("backupTable");

// =======================
// LOAD LIST BACKUP
// =======================

async function loadBackupList(){

    table.innerHTML = `
        <tr>
            <td colspan="5" class="text-center text-muted py-4">
                <span class="spinner-border spinner-border-sm me-2"></span> Memuat data...
            </td>
        </tr>
    `;

    try{

        const response = await fetch("/backup/list" + window.location.search);
        const result = await response.json();

        if(!result.success){

            table.innerHTML = `
                <tr>
                    <td colspan="5" class="text-danger text-center py-4">
                        ❌ ${result.message}
                    </td>
                </tr>
            `;

            return;

        }

        if(!result.files || result.files.length === 0){

            table.innerHTML = `
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        Belum ada file backup tersedia. Silakan klik tombol "Buat Backup Sekarang".
                    </td>
                </tr>
            `;

            return;

        }

        table.innerHTML = "";

        result.files.forEach(file=>{

            const rawSize = file.metadata && file.metadata.size ? file.metadata.size : 0;
            const size = rawSize > 0 ? (rawSize > 1024 * 1024 ? (rawSize / (1024 * 1024)).toFixed(2) + " MB" : Math.round(rawSize / 1024) + " KB") : "-";

            const created = file.created_at ? new Date(file.created_at).toLocaleString("id-ID") : "-";
            const sourceBadge = file.source === "local" 
                ? '<span class="badge bg-secondary">📁 Lokal</span>' 
                : '<span class="badge bg-info text-dark">☁️ Cloud</span>';

            table.innerHTML += `

                <tr>

                    <td><strong>${file.name}</strong></td>

                    <td>${size}</td>

                    <td>${sourceBadge}</td>

                    <td>${created}</td>

                    <td class="text-center">

                        <button
                            class="btn btn-primary btn-sm"
                            onclick="downloadBackup('${file.name}')">

                            ⬇ Unduh SQL

                        </button>

                    </td>

                </tr>

            `;

        });

    }

    catch(err){

        table.innerHTML = `
            <tr>
                <td colspan="5" class="text-danger text-center py-4">
                    ❌ ${err.message}
                </td>
            </tr>
        `;

    }

}

// =======================
// BACKUP DATABASE SEKARANG
// =======================

btn.addEventListener("click", async ()=>{

    btn.disabled = true;

    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Menjalankan Backup...';

    status.className = "ms-2 text-primary fw-bold";

    status.innerHTML = "Memproses dump database...";

    try{

        const response = await fetch("/backup/now" + window.location.search, {

            method: "POST"

        });

        const result = await response.json();

        if(result.success){

            status.className = "ms-2 text-success fw-bold";

            status.innerHTML = "✅ Selesai: " + result.fileName;

            alert("Backup database berhasil dibuat: " + result.fileName);

            await loadBackupList();

        }

        else{

            status.className = "ms-2 text-danger fw-bold";

            status.innerHTML = "❌ Gagal";

            alert(result.message);

        }

    }

    catch(err){

        status.className = "ms-2 text-danger fw-bold";

        status.innerHTML = "❌ Error";

        alert(err.message);

    }

    btn.disabled = false;

    btn.innerHTML = "💾 Buat Backup Sekarang";

});

// =======================
// DOWNLOAD BACKUP
// =======================

async function downloadBackup(fileName){

    try{

        const response = await fetch(
            "/backup/download/" + encodeURIComponent(fileName) + window.location.search,
            { headers: { "Accept": "application/json" } }
        );

        const result = await response.json();

        if(!result.success){

            alert(result.message);
            return;

        }

        // Buka download URL
        window.location.href = result.url;

    }

    catch(err){

        // Fallback langsung ke URL unduhan
        window.location.href = "/backup/download/" + encodeURIComponent(fileName) + window.location.search;

    }

}

// Muat daftar saat halaman dibuka
loadBackupList();

</script>

<%- include("partials/footer") %>