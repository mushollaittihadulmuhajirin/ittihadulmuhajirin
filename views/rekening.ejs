<%- include("partials/header", { title: "Master Rekening Bank — DKM Crystal" }) %>
<%- include("partials/navbar") %>

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">
            <i class="bi bi-bank text-success"></i> Master Rekening Bank
        </h1>
        <div class="admin-page-subtitle">
            <span>Kelola daftar rekening bank masjid untuk penerimaan transaksi non-tunai dan donasi</span>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="/pengaturan-donasi" class="btn btn-warning btn-sm fw-semibold">
            <i class="bi bi-qr-code-scan"></i> Pengaturan Donasi &amp; QRIS
        </a>
        <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- FORM TAMBAH REKENING -->
    <div class="col-12 col-lg-4">
        <div class="card admin-card shadow-sm border-0 rounded-4">
            <div class="card-header bg-success text-white py-3" style="border-radius: 16px 16px 0 0;">
                <h5 class="mb-0 fw-bold fs-6"><i class="bi bi-plus-circle me-1"></i> Tambah Rekening Baru</h5>
            </div>
            <div class="card-body p-3 p-md-4">
                <form method="POST" action="/rekening/simpan">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Nama Bank <span class="text-danger">*</span></label>
                        <input
                            type="text"
                            name="bank"
                            class="form-control"
                            placeholder="Contoh: Mandiri, BSI, BCA"
                            required>
                        <div class="form-text small text-muted">Nama institusi perbankan resmi</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Nomor Rekening <span class="text-danger">*</span></label>
                        <input
                            type="text"
                            name="no_rekening"
                            class="form-control font-monospace fw-bold"
                            placeholder="Contoh: 156-00-2345678-9"
                            required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Nama Pemilik / Atas Nama <span class="text-danger">*</span></label>
                        <input
                            type="text"
                            name="nama_pemilik"
                            class="form-control"
                            placeholder="Contoh: DKM ITTIHADUL MUHAJIRIN"
                            required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Keterangan (Opsional)</label>
                        <textarea
                            name="keterangan"
                            class="form-control"
                            rows="2"
                            placeholder="Catatan peruntukan rekening (misal: Rekening Operasional)"></textarea>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
                        <i class="bi bi-save2 me-1"></i> Simpan Rekening
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- DAFTAR REKENING TERDAFTAR -->
    <div class="col-12 col-lg-8">
        <div class="card admin-card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom" style="border-radius: 16px 16px 0 0;">
                <h5 class="mb-0 fw-bold fs-6 text-dark"><i class="bi bi-credit-card-2-front text-primary me-2"></i>Daftar Rekening Bank Aktif</h5>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <%= (data && data.length) ? data.length : 0 %> Rekening
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th style="width: 50px;" class="text-center">No</th>
                            <th>Nama Bank</th>
                            <th>Nomor Rekening</th>
                            <th>Atas Nama</th>
                            <th style="width: 100px;" class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data && data.length > 0) { %>
                            <% data.forEach((item, idx) => { %>
                                <tr>
                                    <td class="text-center text-muted fw-semibold small"><%= idx + 1 %></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold px-2 py-1">
                                                <i class="bi bi-building me-1"></i> <%= item.bank %>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <code class="font-monospace fw-bold text-dark fs-6"><%= item.no_rekening %></code>
                                    </td>
                                    <td class="fw-semibold text-secondary">
                                        <%= item.nama_pemilik %>
                                    </td>
                                    <td class="text-center">
                                        <a
                                            href="/rekening/hapus/<%= item.id %>"
                                            class="btn btn-outline-danger btn-sm"
                                            title="Hapus Rekening"
                                            onclick="return confirm('Hapus rekening <%= item.bank %> - <%= item.no_rekening %>?')">
                                            <i class="bi bi-trash"></i> Hapus
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                    Belum ada rekening bank yang tersimpan.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include("partials/footer") %>