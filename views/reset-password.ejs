<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons 1.11.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Dedicated Admin Stylesheet -->
    <link rel="stylesheet" href="/css/admin.css">

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body.reset-page {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #064e3b 0%, #0f172a 100%);
            margin: 0;
            padding: 0;
            width: 100%;
            overflow-x: hidden;
        }

        .reset-card {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border-radius: 18px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin: 0 auto;
        }

        .reset-header {
            background: linear-gradient(135deg, #065f46 0%, #047857 100%);
            color: #ffffff;
            padding: 26px 20px;
            text-align: center;
        }

        .reset-logo-container {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 76px;
            height: 76px;
            background: #0f172a;
            border: 2px solid rgba(255, 255, 255, 0.25);
            border-radius: 18px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
            margin-bottom: 14px;
            padding: 6px;
            overflow: hidden;
        }

        .reset-logo-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .reset-title {
            font-size: 1.35rem;
            font-weight: 700;
            margin: 0;
            letter-spacing: -0.01em;
        }

        .reset-subtitle {
            font-size: 0.8125rem;
            color: rgba(255, 255, 255, 0.85);
            margin-top: 6px;
            line-height: 1.45;
        }

        .reset-body {
            padding: 28px 24px;
        }

        .reset-btn {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            border: none;
            color: #ffffff;
            font-weight: 600;
            padding: 12px;
            border-radius: 10px;
            transition: all 0.2s ease;
        }

        .reset-btn:hover {
            background: linear-gradient(135deg, #047857 0%, #065f46 100%);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.35);
            transform: translateY(-1px);
        }

        .reset-footer-links {
            text-align: center;
            padding: 16px 24px 24px;
            border-top: 1px solid #f1f5f9;
        }
    </style>
</head>
<body class="reset-page">

<div class="container d-flex align-items-center justify-content-center min-vh-100 py-3 px-3">
    <div class="reset-card">
        
        <div class="reset-header">
            <div class="reset-logo-container">
                <img 
                    src="/images/hero/logo-dkm-muhajirin.png" 
                    alt="Logo Masjid Ittihadul Muhajirin" 
                    class="reset-logo-img">
            </div>
            <h2 class="reset-title">Buat Password Baru</h2>
            <div class="reset-subtitle">
                Atur kata sandi baru untuk akun: <strong class="text-white"><%= username %></strong>
            </div>
        </div>

        <div class="reset-body">
            
            <% if (error) { %>
                <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3 rounded-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
                    <div><%= error %></div>
                </div>
            <% } %>

            <form method="POST" action="/reset-password">
                <input type="hidden" name="token" value="<%= token %>">

                <!-- PASSWORD BARU -->
                <div class="mb-3">
                    <label for="password_baru" class="form-label small fw-semibold text-secondary">Password Baru</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-key"></i>
                        </span>
                        <input
                            type="password"
                            name="password_baru"
                            id="password_baru"
                            class="form-control border-start-0 border-end-0"
                            placeholder="Minimal 6 karakter"
                            minlength="6"
                            required
                            autofocus>
                        <button
                            class="btn btn-outline-secondary border-start-0 bg-light text-muted"
                            type="button"
                            id="btnToggleReset1">
                            <i class="bi bi-eye" id="eyeReset1"></i>
                        </button>
                    </div>
                </div>

                <!-- KONFIRMASI PASSWORD -->
                <div class="mb-4">
                    <label for="konfirmasi" class="form-label small fw-semibold text-secondary">Konfirmasi Password Baru</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-shield-check"></i>
                        </span>
                        <input
                            type="password"
                            name="konfirmasi"
                            id="konfirmasi"
                            class="form-control border-start-0 border-end-0"
                            placeholder="Ulangi password baru"
                            minlength="6"
                            required>
                        <button
                            class="btn btn-outline-secondary border-start-0 bg-light text-muted"
                            type="button"
                            id="btnToggleReset2">
                            <i class="bi bi-eye" id="eyeReset2"></i>
                        </button>
                    </div>
                </div>

                <!-- TOMBOL SIMPAN -->
                <button type="submit" class="btn reset-btn w-100 d-flex align-items-center justify-content-center gap-2 mb-2">
                    <i class="bi bi-check-circle fs-5"></i>
                    <span>Simpan Password Baru</span>
                </button>

            </form>
        </div>

        <div class="reset-footer-links">
            <a href="/login" class="text-decoration-none small text-muted d-inline-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Batal &amp; Kembali ke Login
            </a>
        </div>

    </div>
</div>

<script>
    function setupToggle(btnId, inputId, iconId) {
        const btn = document.getElementById(btnId);
        const inp = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (btn && inp && icon) {
            btn.addEventListener("click", () => {
                if (inp.type === "password") {
                    inp.type = "text";
                    icon.className = "bi bi-eye-slash";
                } else {
                    inp.type = "password";
                    icon.className = "bi bi-eye";
                }
            });
        }
    }
    setupToggle("btnToggleReset1", "password_baru", "eyeReset1");
    setupToggle("btnToggleReset2", "konfirmasi", "eyeReset2");
</script>

</body>
</html>

