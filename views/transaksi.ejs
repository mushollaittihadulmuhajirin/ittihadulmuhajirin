<!-- ===================================================== -->
<!-- 1. RIWAYAT TRANSAKSI UANG -->
<!-- ===================================================== -->

<div class="card shadow-soft mt-4">

    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            💰 Riwayat Transaksi Uang
        </h5>
        <span class="badge bg-light text-dark fw-bold">
            <%= (transaksi && transaksi.length) ? transaksi.length : 0 %> Data
        </span>
    </div>

    <!-- Filter Bar Uang -->
    <div class="table-filter-bar">
        <div class="input-group input-group-sm" style="max-width: 250px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" id="searchUang" class="form-control" placeholder="Cari keterangan, nominal...">
        </div>

        <div class="table-filter-item">
            <span class="small text-muted">Jenis:</span>
            <select id="filterJenisUang" class="form-select form-select-sm" style="width: auto;">
                <option value="semua">Semua Jenis</option>
                <option value="masuk">Pemasukan</option>
                <option value="keluar">Pengeluaran</option>
            </select>
        </div>

        <div class="table-filter-item">
            <span class="small text-muted">Metode:</span>
            <select id="filterMetodeUang" class="form-select form-select-sm" style="width: auto;">
                <option value="semua">Semua Metode</option>
                <option value="tunai">Tunai</option>
                <option value="transfer">Non Tunai</option>
            </select>
        </div>

        <div class="table-filter-item">
            <span class="small text-muted">Dari:</span>
            <input type="date" id="filterMulaiUang" class="form-control form-control-sm" style="width: auto;">
        </div>

        <div class="table-filter-item">
            <span class="small text-muted">Sampai:</span>
            <input type="date" id="filterSampaiUang" class="form-control form-control-sm" style="width: auto;">
        </div>

        <button type="button" id="btnResetUang" class="btn btn-outline-secondary btn-sm ms-auto">
            <i class="bi bi-arrow-counterclockwise"></i> Reset
        </button>
    </div>

    <div class="card-body p-0 table-responsive">

        <table class="table table-bordered table-hover align-middle mb-0">

            <thead class="table-light">

                <tr>

                    <th width="45" class="text-center">No</th>

                    <th>📅 Tanggal</th>

                    <th>💳 Jenis</th>

                    <th>📂 Kategori</th>

                    <th>🏦 Metode</th>

                    <th>💳 Rekening</th>

                    <th class="text-end">💰 Nominal</th>

                    <th>📝 Keterangan</th>

                    <th width="150" class="text-center">⚡ Aksi</th>

                </tr>

            </thead>

            <tbody id="tbodyUang">

            <% if(transaksi && transaksi.length){ %>

                <% transaksi.forEach(function(item,index){ %>

                <tr data-tanggal="<%= item.tanggal ? new Date(item.tanggal).toISOString().slice(0,10) : '' %>"
                    data-jenis="<%= (item.jenis || '').toLowerCase().trim() %>"
                    data-metode="<%= (item.metode || '').toLowerCase().trim() %>">

                    <td class="text-center text-muted">
                        <%= index+1 %>
                    </td>

                    <td>
                        <%= new Date(item.tanggal).toLocaleDateString("id-ID") %>
                    </td>

                    <td>

                        <% if(item.jenis==="masuk"){ %>

                            <span class="badge bg-success">
                                <i class="bi bi-arrow-up-right me-1"></i>Pemasukan
                            </span>

                        <% }else{ %>

                            <span class="badge bg-danger">
                                <i class="bi bi-arrow-down-left me-1"></i>Pengeluaran
                            </span>

                        <% } %>

                    </td>

                    <td>
                        <%= item.kategori || "-" %>
                    </td>

                    <td>

                        <% if(item.metode==="transfer"){ %>

                            <span class="badge bg-primary">
                                <i class="bi bi-bank me-1"></i>Non Tunai
                            </span>

                        <% }else{ %>

                            <span class="badge bg-secondary">
                                <i class="bi bi-cash me-1"></i>Tunai
                            </span>

                        <% } %>

                    </td>

                    <td>

                        <% if(item.metode==="transfer"){ %>

                            <%= item.nama_rekening || "-" %>

                        <% }else{ %>

                            -

                        <% } %>

                    </td>

                    <td class="text-end fw-bold <%= item.jenis === 'masuk' ? 'text-success' : 'text-danger' %>">

                        Rp <%= Number(item.nominal||0).toLocaleString("id-ID") %>

                    </td>

                    <td>

                        <%= item.keterangan || "-" %>

                    </td>

                    <td class="text-center">

                        <div class="btn-group btn-group-sm">
                            <a
                            href="/transaksi/edit/<%= item.id %>"
                            class="btn btn-warning btn-sm"
                            title="Edit Transaksi">
                                ✏ Edit
                            </a>

                            <a
                            href="/transaksi/hapus/<%= item.id %>"
                            class="btn btn-danger btn-sm"
                            title="Hapus Transaksi"
