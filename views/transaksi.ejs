<script>

/* =====================================================
   AUTO TANGGAL HARI INI
===================================================== */

document.addEventListener("DOMContentLoaded",function(){

    const today=new Date().toISOString().split("T")[0];

    [
        "tanggal_uang",
        "tanggal_donasi",
        "tanggal_inventaris"
    ].forEach(function(id){

        const el=document.getElementById(id);

        if(el && !el.value){

            el.value=today;

        }

    });

});


/* =====================================================
   SWITCH FORM
===================================================== */

const jenisInput=document.getElementById("jenis_input");

const formUang=document.getElementById("formUang");

const formDonasi=document.getElementById("formDonasi");

const formInventaris=document.getElementById("formInventaris");

function tampilkanForm(){

    if(!formUang || !formDonasi || !formInventaris) return;

    formUang.style.display="none";
    formDonasi.style.display="none";
    formInventaris.style.display="none";

    if(jenisInput.value==="uang"){

        formUang.style.display="block";

    }

    if(jenisInput.value==="donasi"){

        formDonasi.style.display="block";

    }

    if(jenisInput.value==="inventaris"){

        formInventaris.style.display="block";

    }

}

// Deteksi parameter URL untuk pemilihan tab formulir otomatis (misal: ?jenis=inventaris)
try {
    const urlParams = new URLSearchParams(window.location.search);
    const targetType = urlParams.get("jenis") || urlParams.get("tab") || urlParams.get("tipe");
    if (targetType && jenisInput) {
        const cleanType = targetType.toLowerCase().trim();
        if (cleanType === "inventaris" || cleanType === "donasi" || cleanType === "uang") {
            jenisInput.value = cleanType;
        }
    }
} catch (e) {
    console.error("URL param error:", e);
}

tampilkanForm();

if(jenisInput){
    jenisInput.addEventListener("change",tampilkanForm);
}


/* =====================================================
   TUNAI / TRANSFER
===================================================== */

const metode=document.getElementById("metode");

const rekeningGroup=document.getElementById("rekeningGroup");

const rekeningSelect=document.getElementById("rekening_id");

function toggleRekening(){

    if(!metode) return;

    if(metode.value==="tunai"){

        rekeningGroup.style.display="none";

        rekeningSelect.value="";

        rekeningSelect.removeAttribute("required");

    }else{

        rekeningGroup.style.display="block";

        rekeningSelect.setAttribute("required","required");

    }

}

if(metode){

    toggleRekening();

    metode.addEventListener("change",toggleRekening);

}


/* =====================================================
   FORMAT INPUT ANGKA
===================================================== */

document.querySelectorAll("input[type='number']").forEach(function(el){

    el.addEventListener("wheel",function(){

        this.blur();

    });

});


/* =====================================================
   RESET FORM
===================================================== */

document.querySelectorAll("form").forEach(function(frm){

    frm.addEventListener("reset",function(){

        setTimeout(function(){

            tampilkanForm();

            toggleRekening();

        },100);

    });

});

/* =====================================================
   UNIVERSAL TABLE PAGINATOR & FILTER (INDEPENDENT)
===================================================== */

class AdminTablePaginator {
    constructor(config) {
        this.tbody = document.getElementById(config.tbodyId);
        this.infoEl = document.getElementById(config.infoId);
        this.navEl = document.getElementById(config.navId);
        this.pageSizeSelect = document.getElementById(config.pageSizeId);
        this.searchInput = document.getElementById(config.searchId);
        this.filterMulai = document.getElementById(config.mulaiId);
        this.filterSampai = document.getElementById(config.sampaiId);
        this.filterJenis = config.jenisId ? document.getElementById(config.jenisId) : null;
        this.filterMetode = config.metodeId ? document.getElementById(config.metodeId) : null;
        this.filterKondisi = config.kondisiId ? document.getElementById(config.kondisiId) : null;
        this.btnReset = document.getElementById(config.resetId);

        if (!this.tbody) return;
        this.allRows = Array.from(this.tbody.querySelectorAll("tr"));
        this.currentPage = 1;
        this.pageSize = 10;

        this.init();
    }

    init() {
        if (this.pageSizeSelect) {
            this.pageSizeSelect.addEventListener("change", (e) => {
                const v = e.target.value;
                this.pageSize = (v === "all") ? 999999 : parseInt(v);
                this.currentPage = 1;
                this.render();
            });
        }

        const triggerFilter = () => {
            this.currentPage = 1;
            this.render();
        };

        if (this.searchInput) this.searchInput.addEventListener("input", triggerFilter);
        if (this.filterMulai) this.filterMulai.addEventListener("change", triggerFilter);
        if (this.filterSampai) this.filterSampai.addEventListener("change", triggerFilter);
        if (this.filterJenis) this.filterJenis.addEventListener("change", triggerFilter);
        if (this.filterMetode) this.filterMetode.addEventListener("change", triggerFilter);
        if (this.filterKondisi) this.filterKondisi.addEventListener("change", triggerFilter);

        if (this.btnReset) {
            this.btnReset.addEventListener("click", () => {
                if (this.searchInput) this.searchInput.value = "";
                if (this.filterMulai) this.filterMulai.value = "";
                if (this.filterSampai) this.filterSampai.value = "";
                if (this.filterJenis) this.filterJenis.value = "semua";
                if (this.filterMetode) this.filterMetode.value = "semua";
                if (this.filterKondisi) this.filterKondisi.value = "semua";
                this.currentPage = 1;
                this.render();
            });
        }

        this.render();
    }

    getFilteredRows() {
        const query = (this.searchInput ? this.searchInput.value : "").toLowerCase().trim();
        const mulai = this.filterMulai ? this.filterMulai.value : "";
        const sampai = this.filterSampai ? this.filterSampai.value : "";
        const jenis = this.filterJenis ? this.filterJenis.value : "semua";
        const metode = this.filterMetode ? this.filterMetode.value : "semua";
        const kondisi = this.filterKondisi ? this.filterKondisi.value : "semua";

        return this.allRows.filter(row => {
            // Ignore placeholder row if table has no data
            if (row.cells.length <= 1) return false;

            // Search query across row text content
            if (query && !row.textContent.toLowerCase().includes(query)) {
                return false;
            }

            // Date filter
            const rowTanggal = row.dataset.tanggal || "";
            if (mulai && rowTanggal && rowTanggal < mulai) return false;
            if (sampai && rowTanggal && rowTanggal > sampai) return false;

            // Jenis filter
            if (jenis !== "semua" && (row.dataset.jenis || "") !== jenis) {
                return false;
            }

            // Metode filter
            if (metode !== "semua" && (row.dataset.metode || "") !== metode) {
                return false;
            }

            // Kondisi filter
            if (kondisi !== "semua" && (row.dataset.kondisi || "") !== kondisi) {
                return false;
            }

            return true;
        });
    }

    goToPage(page) {
        this.currentPage = page;
        this.render();
    }

    render() {
        const activeRows = this.getFilteredRows();
        const total = activeRows.length;
        const totalPages = Math.max(1, Math.ceil(total / this.pageSize));

        if (this.currentPage > totalPages) this.currentPage = totalPages;
        if (this.currentPage < 1) this.currentPage = 1;

        const startIdx = (this.currentPage - 1) * this.pageSize;
        const endIdx = startIdx + this.pageSize;

        // Hide all rows
        this.allRows.forEach(r => r.style.display = "none");

        // Show active slice
        activeRows.slice(startIdx, endIdx).forEach(r => r.style.display = "");

        // Update info text
        if (this.infoEl) {
            if (total === 0) {
                this.infoEl.textContent = "Menampilkan 0 data";
            } else {
                const displayStart = startIdx + 1;
                const displayEnd = Math.min(endIdx, total);
                this.infoEl.textContent = `Menampilkan ${displayStart}–${displayEnd} dari ${total} data`;
            }
        }

        // Render nav buttons
        if (this.navEl) {
            this.navEl.innerHTML = "";
            if (totalPages > 1) {
                // Prev btn
                const prevBtn = document.createElement("button");
                prevBtn.type = "button";
                prevBtn.className = "btn-page-step";
                prevBtn.innerHTML = "<i class='bi bi-chevron-left'></i> Prev";
                prevBtn.disabled = (this.currentPage === 1);
                prevBtn.addEventListener("click", () => this.goToPage(this.currentPage - 1));
                this.navEl.appendChild(prevBtn);

                // Number buttons (max 5)
                let startPage = Math.max(1, this.currentPage - 2);
                let endPage = Math.min(totalPages, startPage + 4);
                if (endPage - startPage < 4) {
                    startPage = Math.max(1, endPage - 4);
                }

                for (let i = startPage; i <= endPage; i++) {
                    const pageBtn = document.createElement("button");
                    pageBtn.type = "button";
                    pageBtn.className = "btn-page-step" + (i === this.currentPage ? " active" : "");
                    pageBtn.textContent = i;
                    pageBtn.addEventListener("click", () => this.goToPage(i));
                    this.navEl.appendChild(pageBtn);
                }

                // Next btn
                const nextBtn = document.createElement("button");
                nextBtn.type = "button";
                nextBtn.className = "btn-page-step";
                nextBtn.innerHTML = "Next <i class='bi bi-chevron-right'></i>";
                nextBtn.disabled = (this.currentPage === totalPages);
                nextBtn.addEventListener("click", () => this.goToPage(this.currentPage + 1));
                this.navEl.appendChild(nextBtn);
            }
        }
    }
}

// Inisialisasi Paginator Independen untuk ketiga tabel
document.addEventListener("DOMContentLoaded", function() {
    window.paginatorUang = new AdminTablePaginator({
        tbodyId: "tbodyUang",
        infoId: "infoUang",
        navId: "navUang",
        pageSizeId: "pageSizeUang",
        searchId: "searchUang",
        mulaiId: "filterMulaiUang",
        sampaiId: "filterSampaiUang",
        jenisId: "filterJenisUang",
        metodeId: "filterMetodeUang",
        resetId: "btnResetUang"
    });

    window.paginatorDonasi = new AdminTablePaginator({
        tbodyId: "tbodyDonasi",
        infoId: "infoDonasi",
        navId: "navDonasi",
        pageSizeId: "pageSizeDonasi",
        searchId: "searchDonasi",
        mulaiId: "filterMulaiDonasi",
        sampaiId: "filterSampaiDonasi",
        kondisiId: "filterKondisiDonasi",
        resetId: "btnResetDonasi"
    });

