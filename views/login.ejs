<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Pengurus — Panel Admin DKM Crystal</title>

    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons 1.11.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Dedicated Admin Stylesheet -->
    <link rel="stylesheet" href="/css/admin.css">

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body.login-page {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #064e3b 0%, #0f172a 100%);
            margin: 0;
            padding: 0;
            width: 100%;
            overflow-x: hidden;
        }

        .login-card {
            width: 100%;
            max-width: 400px;
            background: #ffffff;
            border-radius: 18px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin: 0 auto;
        }

        .login-header {
            background: linear-gradient(135deg, #065f46 0%, #047857 100%);
            color: #ffffff;
            padding: 26px 20px;
            text-align: center;
        }

        .login-logo-container {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 76px;
            height: 76px;
            background: #0f172a;
            border: 2px solid rgba(255, 255, 255, 0.25);
            border-radius: 18px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
            margin-bottom: 14px;
            padding: 6px;
            overflow: hidden;
        }

        .login-logo-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .login-title {
            font-size: 1.35rem;
            font-weight: 700;
            margin: 0;
            letter-spacing: -0.01em;
        }

        .login-subtitle {
            font-size: 0.8125rem;
            color: rgba(255, 255, 255, 0.8);
            margin-top: 4px;
        }

        .login-body {
            padding: 28px 24px;
        }

        @media (max-width: 480px) {
            .login-body {
                padding: 22px 18px;
            }
            .login-header {
                padding: 22px 16px;
            }
        }

        .login-btn {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            border: none;
            color: #ffffff;
            font-weight: 600;
            padding: 12px;
            border-radius: 10px;
            transition: all 0.2s ease;
        }

        .login-btn:hover {
            background: linear-gradient(135deg, #047857 0%, #065f46 100%);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.35);
            transform: translateY(-1px);
        }

        .login-footer-links {
            text-align: center;
            padding: 16px 24px 24px;
            border-top: 1px solid #f1f5f9;
        }
    </style>
</head>
<body class="login-page">

<div class="container d-flex align-items-center justify-content-center min-vh-100 py-3 px-3">
    <div class="login-card">
    <div class="login-header">
        <div class="login-logo-container">
            <img 
                src="/images/hero/logo-dkm-muhajirin.png" 
                alt="Logo Masjid Ittihadul Muhajirin" 
                class="login-logo-img">
        </div>
        <h2 class="login-title">DKM Crystal</h2>
        <div class="login-subtitle">Panel Masuk Pengurus &amp; Administrasi</div>
    </div>

    <div class="login-body">
        <div id="loginAlertBox" class="d-none"></div>

        <form method="POST" action="/login">
            <div class="mb-3">
                <label for="username" class="form-label small fw-semibold text-secondary">Username</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="bi bi-person"></i>
                    </span>
                    <input
                        type="text"
                        name="username"
                        id="username"
                        class="form-control border-start-0"
                        placeholder="Masukkan username admin"
                        required>
                </div>
            </div>

            <div class="mb-2">
                <label for="password" class="form-label small fw-semibold text-secondary">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="bi bi-shield-lock"></i>
                    </span>
                    <input
                        type="password"
                        name="password"
                        id="password"
                        class="form-control border-start-0 border-end-0"
                        placeholder="Masukkan kata sandi"
                        required>
                    <button
                        class="btn btn-outline-secondary border-start-0 bg-light text-muted"
                        type="button"
                        id="btnTogglePassword"
                        title="Tampilkan / Sembunyikan Password">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-end mb-4">
                <a href="/lupa-password" class="text-decoration-none small text-success fw-medium d-inline-flex align-items-center gap-1">
                    <i class="bi bi-question-circle"></i> Lupa Password?
                </a>
            </div>

            <button type="submit" class="btn login-btn w-100 d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-box-arrow-in-right fs-5"></i>
                <span>Masuk ke Panel Admin</span>
            </button>
        </form>
    </div>

    <div class="login-footer-links">
        <a href="/" class="text-decoration-none small text-muted d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Kembali ke Website Utama
        </a>
    </div>
</div>
</div>

<script>
    const toggleBtn = document.getElementById("btnTogglePassword");
    const pwdInput = document.getElementById("password");
    const eyeIcon = document.getElementById("eyeIcon");

    if (toggleBtn && pwdInput) {
        toggleBtn.addEventListener("click", function() {
            if (pwdInput.type === "password") {
                pwdInput.type = "text";
                eyeIcon.className = "bi bi-eye-slash";
            } else {
                pwdInput.type = "password";
                eyeIcon.className = "bi bi-eye";
            }
        });
    }

    // Tampilkan notifikasi jika ada parameter 'pesan'
    const urlParams = new URLSearchParams(window.location.search);
    const pesan = urlParams.get("pesan");
    const alertBox = document.getElementById("loginAlertBox");
    if (pesan && alertBox) {
        let msg = "";
        if (pesan === "reset_sukses") {
            msg = "Password berhasil diperbarui! Silakan masuk dengan password baru Anda.";
        } else if (pesan === "sukses_ubah_password") {
            msg = "Password berhasil diubah. Silakan login kembali untuk melanjutkan.";
        }
        if (msg) {
            alertBox.className = "alert alert-success py-2 px-3 small d-flex align-items-center gap-2 mb-3 rounded-3";
            alertBox.innerHTML = `<i class="bi bi-check-circle-fill fs-5 text-success"></i><div>${msg}</div>`;
        }
    }
</script>

</body>
</html>