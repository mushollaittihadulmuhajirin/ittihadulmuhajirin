                                        <td><%= item.kategori || '-' %></td>
                                        <td><%= item.nama_barang || '-' %></td>
                                        <td><%= item.jumlah %> <%= item.satuan || '' %></td>
                                        <td><span class="badge bg-secondary"><%= item.kondisi || '-' %></span></td>
                                        <td class="text-end">
                                            <%= item.estimasi_harga ? 'Rp ' + Number(item.estimasi_harga).toLocaleString('id-ID') : '-' %>
