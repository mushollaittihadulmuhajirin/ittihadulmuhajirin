<!-- MODAL POP-UP SARAN & MASUKAN WARGA DKM -->
<div class="modal fade" id="modalSaranMasukan" tabindex="-1" aria-labelledby="modalSaranMasukanLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <!-- HEADER MODAL (STICKY DI ATAS, SOLID & TIDAK TERPOTONG) -->
            <div class="modal-header text-white">
                <div class="d-flex align-items-center gap-2">
                    <div style="width: 36px; height: 36px; background: rgba(255,255,255,0.15); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.15rem;">
                        <i class="bi bi-chat-heart-fill text-warning"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="modalSaranMasukanLabel" style="font-size: 1.05rem;">Saran &amp; Masukan Warga</h5>
                        <p class="mb-0 text-white-50" style="font-size: 0.72rem;">DKM Masjid Ghoiru Jami' Ittihadul Muhajirin</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btnCloseModalSaran"></button>
            </div>

            <!-- FORM WRAPPER (MEMBAGI BODY SCROLLABLE DAN FOOTER TETAP TERLIHAT) -->
            <form id="formSaranMasukan" novalidate class="d-flex flex-column flex-grow-1 overflow-hidden m-0">
                <!-- BODY MODAL (AREA SCROLLABLE VERTIKAL 100DVH SAFE) -->
                <div class="modal-body">
                    <div id="saranAlertBox" class="alert d-none mb-2" role="alert"></div>

                    <!-- FIELD 1: NAMA -->
                    <div class="mb-3">
                        <label for="inputSaranNama" class="form-label fw-semibold small text-dark mb-1">
                            <i class="bi bi-person-fill text-success me-1"></i> Nama Lengkap <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="inputSaranNama" placeholder="Nama warga (misal: Fulan bin Fulan)" required minlength="2" maxlength="100">
                        <div class="invalid-feedback small">Nama wajib diisi minimal 2 karakter.</div>
                    </div>

                    <!-- FIELD 2: BLOK (AUTOCOMPLETE DARI MASTER BLOK DATABASE DINAMIS) -->
                    <div class="mb-3 position-relative" id="autocompleteContainer">
                        <label for="inputSaranBlok" class="form-label fw-semibold small text-dark mb-1 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-geo-alt-fill text-success me-1"></i> Blok Rumah <span class="text-danger">*</span></span>
                            <span class="badge bg-light text-success border border-success border-opacity-25" style="font-size: 0.68rem;" id="badgeBlokCount">
                                <span id="labelTotalBlokText"><%= (typeof totalMasterBlokAktif !== 'undefined' ? totalMasterBlokAktif : '') %></span> Blok Resmi Terdaftar
                            </span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control font-monospace fw-bold text-uppercase" id="inputSaranBlok" placeholder="Ketik blok (misal: A12, K12, B01)..." autocomplete="off" required>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnToggleBlokList" title="Buka seluruh daftar blok">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                        <input type="hidden" id="hiddenSelectedBlok" value="">
                        
                        <!-- DROPDOWN SUGESTI AUTOCOMPLETE (TIDAK TERPOTONG) -->
                        <div id="saranBlokDropdown" class="autocomplete-dropdown shadow-lg d-none">
                            <div class="autocomplete-dropdown-header small text-muted px-3 py-1 bg-light border-bottom d-flex justify-content-between align-items-center">
                                <span>Pilih dari master data resmi:</span>
                                <span id="saranBlokMatchCount" class="badge bg-secondary" style="font-size: 0.65rem;">0 cocok</span>
                            </div>
                            <div id="saranBlokList" class="autocomplete-list" role="listbox"></div>
                        </div>

                        <div class="invalid-feedback d-block small" id="blokValidationFeedback" style="display: none !important;">
                            Silakan ketik dan pilih blok resmi dari daftar sugesti dropdown.
                        </div>
                        <small class="text-muted d-block mt-1" style="font-size: 0.72rem;">
                            <i class="bi bi-info-circle me-1"></i>Ketik untuk mencari. Anda <strong>wajib memilih</strong> satu blok dari daftar sugesti resmi.
                        </small>
                    </div>

                    <!-- FIELD 3: KATEGORI -->
                    <div class="mb-3">
                        <label for="selectSaranKategori" class="form-label fw-semibold small text-dark mb-1">
                            <i class="bi bi-tag-fill text-success me-1"></i> Kategori Masukan <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="selectSaranKategori" required>
                            <option value="" disabled selected>-- Pilih Kategori Masukan --</option>
                            <option value="Pengurus DKM">Pengurus DKM</option>
                            <option value="Marbot">Marbot</option>
                            <option value="TPQ">TPQ</option>
                            <option value="Pembangunan / Renovasi">Pembangunan / Renovasi</option>
                            <option value="Sarana & Prasarana">Sarana & Prasarana</option>
                            <option value="Kebersihan">Kebersihan</option>
                            <option value="Kegiatan">Kegiatan</option>
                            <option value="Lainnya">Lainnya</option>
                        </select>
                        <div class="invalid-feedback small">Silakan pilih kategori masukan.</div>
                    </div>

                    <!-- FIELD 4: PESAN ATAU MASUKAN -->
                    <div class="mb-2">
                        <label for="textareaSaranPesan" class="form-label fw-semibold small text-dark mb-1">
                            <i class="bi bi-pencil-square text-success me-1"></i> Pesan / Masukan <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control" id="textareaSaranPesan" rows="3" placeholder="Tuliskan saran, kritik membangun, atau masukan untuk DKM di sini..." required minlength="5" maxlength="2000"></textarea>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <div class="invalid-feedback small">Pesan wajib diisi minimal 5 karakter.</div>
                            <small class="text-muted ms-auto" id="saranCharCounter">0 / 2000</small>
                        </div>
                    </div>
                </div>

                <!-- FOOTER MODAL (STICKY DI BAWAH DENGAN BACKGROUND SOLID, TOMBOL SELALU TERJANGKAU) -->
                <div class="modal-footer">
