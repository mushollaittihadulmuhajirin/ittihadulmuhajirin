// =======================================================
// SALDO ACUAN RESMI CUT-OFF DKM V1
// - Saldo Total: Rp 8.386.296 (Masuk - Keluar)
// - Saldo Tunai: Rp 5.182.000 (Kas & Dompet, pembulatan kelipatan Rp 100)
// - Saldo Non-Tunai: Rp 3.204.296,51 (Bank Mandiri, nilai desimal persis)
// =======================================================
const currentSaldoTotal = (typeof saldoTotal !== 'undefined') ? Number(saldoTotal) : (typeof saldo !== 'undefined' ? Number(saldo) : 8386296);
const currentSaldoTunai = (typeof saldoTunai !== 'undefined') ? Number(saldoTunai) : 5182000;
const currentSaldoNonTunai = (typeof saldoNonTunai !== 'undefined') ? Number(saldoNonTunai) : 3204296.51;

// Helper format Rupiah khusus laporan
function formatRupiahTampilan(val, isDecimal) {
    const num = Number(val || 0);
    if (isDecimal) {
        return num.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    return Math.round(num).toLocaleString('id-ID');
}

// Format Tanggal Hari Ini (Indonesia)
const dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
const todayFormatted = new Date().toLocaleDateString('id-ID', dateOptions);
