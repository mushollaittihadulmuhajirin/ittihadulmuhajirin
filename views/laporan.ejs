<!-- ======================================================= -->
<!-- MODAL DIALOG EXPORT LAPORAN (PDF & EXCEL)               -->
<!-- ======================================================= -->
<div class="modal fade" id="modalExportDialog" tabindex="-1" aria-labelledby="modalExportLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header modal-header-custom" style="background: #065f46; border-radius: 16px 16px 0 0;">
                <div>
                    <h5 class="modal-title font-monospace fw-bold text-white mb-0" id="modalExportLabel" style="font-size: 1.05rem;">
                        <i class="bi bi-file-earmark-arrow-down-fill me-2"></i>Export Laporan Keuangan
                    </h5>
                    <p class="mb-0 text-white-50" style="font-size: 0.75rem;">Pilih format, rentang tanggal, dan jenis data untuk diekspor.</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 p-sm-4">
                <form id="formExportDialog" onsubmit="return false;">
                    <!-- Format Berkas Pilihan -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted text-uppercase mb-2" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                            Format Berkas
                        </label>
                        <div class="row g-2">
                            <div class="col-12 col-sm-6">
                                <div class="export-format-card active-format-pdf" id="formatCardPdf">
                                    <div class="d-flex align-items-center gap-2 mb-0 mb-sm-1">
                                        <input type="radio" name="exportFormat" value="pdf" id="exportFormatPdf" checked class="form-check-input mt-0 flex-shrink-0">
                                        <label for="exportFormatPdf" class="fw-bold mb-0 text-dark small" style="cursor: pointer; font-size: 0.82rem;">
                                            <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i>Dokumen PDF
                                        </label>
                                    </div>
                                    <div class="text-muted ps-4 d-none d-sm-block" style="font-size: 0.7rem;">Format cetak A4 rapi</div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <div class="export-format-card" id="formatCardExcel">
                                    <div class="d-flex align-items-center gap-2 mb-0 mb-sm-1">
                                        <input type="radio" name="exportFormat" value="excel" id="exportFormatExcel" class="form-check-input mt-0 flex-shrink-0">
                                        <label for="exportFormatExcel" class="fw-bold mb-0 text-dark small" style="cursor: pointer; font-size: 0.82rem;">
                                            <i class="bi bi-file-earmark-excel-fill text-success me-1"></i>Spreadsheet Excel
                                        </label>
                                    </div>
                                    <div class="text-muted ps-4 d-none d-sm-block" style="font-size: 0.7rem;">Format berkas .XLSX</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Jenis Data -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted text-uppercase mb-1" for="exportJenisData" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                            Jenis Data Laporan
                        </label>
                        <select class="form-select form-select-sm" id="exportJenisData" style="border-radius: 8px;">
                            <option value="semua">Semua Data (Transaksi, Donasi &amp; Inventaris)</option>
                            <option value="uang">💰 Riwayat Transaksi Uang</option>
                            <option value="donasi">🎁 Data Donasi Barang</option>
                            <option value="aset">📦 Inventaris Masjid</option>
                        </select>
                    </div>

                    <!-- Metode Pembayaran (Hanya aktif jika Transaksi Uang) -->
                    <div class="mb-3" id="exportMetodeGroup">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-bold text-muted text-uppercase mb-0" for="exportMetode" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                                Metode Pembayaran
                            </label>
                            <span class="badge bg-light text-muted border" id="exportMetodeHint" style="font-size: 0.68rem;">Khusus Transaksi Uang</span>
                        </div>
                        <select class="form-select form-select-sm" id="exportMetode" disabled style="border-radius: 8px; opacity: 0.55;">
                            <option value="semua">Semua Metode (Tunai &amp; Transfer)</option>
                            <option value="tunai">Hanya Tunai</option>
                            <option value="transfer">Hanya Transfer</option>
                        </select>
                    </div>

                    <!-- Rentang Tanggal -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-bold text-muted text-uppercase mb-0" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                                Rentang Tanggal
                            </label>
                            <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 text-success" id="btnResetExportDates" style="font-size: 0.75rem;">
                                <i class="bi bi-arrow-counterclockwise"></i> Reset / Semua Waktu
                            </button>
                        </div>
                        <div class="row g-2">
                            <div class="col-12 col-sm-6">
                                <label for="exportTanggalMulai" class="form-label small text-muted mb-1" style="font-size: 0.75rem;">Dari Tanggal</label>
                                <input type="date" class="form-control form-control-sm" id="exportTanggalMulai" style="border-radius: 8px;">
                            </div>
                            <div class="col-12 col-sm-6">
                                <label for="exportTanggalSampai" class="form-label small text-muted mb-1" style="font-size: 0.75rem;">Sampai Tanggal</label>
                                <input type="date" class="form-control form-control-sm" id="exportTanggalSampai" style="border-radius: 8px;">
                            </div>
                        </div>
                        <div class="form-text text-muted mt-1" style="font-size: 0.72rem;">
                            <i class="bi bi-info-circle text-primary"></i> Kosongkan kedua tanggal untuk mengekspor <strong>seluruh data</strong>.
                        </div>
                    </div>

                    <!-- Alert Validasi Error -->
                    <div class="alert alert-danger d-none py-2 px-3 small align-items-center gap-2 mb-0" id="exportAlertError" role="alert" style="border-radius: 8px;">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 fs-6"></i>
                        <span id="exportAlertErrorText">Tanggal awal tidak boleh lebih besar dari tanggal akhir.</span>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light px-3 px-sm-4 py-3 d-flex justify-content-between align-items-center gap-2" style="border-radius: 0 0 16px 16px;">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">
                    Batal
                </button>
                <button type="button" class="btn btn-danger btn-sm px-3 px-sm-4 fw-semibold text-nowrap" id="btnSubmitExport">
                    <span id="btnSubmitExportText"><i class="bi bi-file-earmark-pdf-fill me-1"></i> Unduh PDF</span>
                </button>
            </div>
        </div>
    </div>
</div>

