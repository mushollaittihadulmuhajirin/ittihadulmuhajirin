<!-- JAVASCRIPT FRONTEND: CHART, FILTERING & INDEPENDENT PAGINATION -->
<script>
    // =======================================================
    // 0. HELPER SALIN REKENING & MODAL QRIS
    // =======================================================
    function salinNomorRekening(nomor, btn) {
        if (!navigator.clipboard) {
            const textArea = document.createElement("textarea");
            textArea.value = nomor;
            document.body.appendChild(textArea);
            textArea.select();
            try {
                document.execCommand('copy');
                tampilkanFeedbackSalin(btn);
            } catch (err) {
                prompt("Silakan salin nomor rekening secara manual:", nomor);
            }
            document.body.removeChild(textArea);
            return;
        }
        navigator.clipboard.writeText(nomor).then(function() {
            tampilkanFeedbackSalin(btn);
        }).catch(function(err) {
            prompt("Silakan salin nomor rekening secara manual:", nomor);
        });
    }

    function tampilkanFeedbackSalin(btn) {
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check2-circle text-success me-1"></i> Tersalin!';
        btn.classList.add('btn-copied');
        setTimeout(function() {
            btn.innerHTML = originalHtml;
            btn.classList.remove('btn-copied');
        }, 2500);
    }

    function bukaModalZoomQris() {
        const modalEl = document.getElementById('modalZoomQris');
        if (modalEl && window.bootstrap) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }

    // =======================================================
    // 1. DATA TRANSAKSI UNTUK GRAFIK KEUANGAN (REAL DATA)
    // =======================================================
    const rawTransactions = <%- JSON.stringify(data || []) %>;

    // Bulan Jan - Des
    const monthLabels = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agu", "Sep", "Okt", "Nov", "Des"];

    // Kumpulkan Tahun yang ada di data
    const availableYears = new Set();
    rawTransactions.forEach(t => {
        if (t.tanggal) {
            const yr = new Date(t.tanggal).getFullYear();
            if (!isNaN(yr)) availableYears.add(yr);
        }
    });

    const yearSelect = document.getElementById("chartYearFilter");
    Array.from(availableYears).sort((a, b) => b - a).forEach(yr => {
        const opt = document.createElement("option");
        opt.value = yr;
        opt.textContent = "Tahun " + yr;
        yearSelect.appendChild(opt);
    });

    function calculateMonthlyData(selectedYear) {
        const masukData = new Array(12).fill(0);
        const keluarData = new Array(12).fill(0);

        rawTransactions.forEach(t => {
            if (!t.tanggal) return;
            const d = new Date(t.tanggal);
            if (isNaN(d.getTime())) return;

            const yr = d.getFullYear();
            if (selectedYear !== "all" && yr !== parseInt(selectedYear)) return;

            const m = d.getMonth(); // 0..11
            const nom = Number(t.nominal) || 0;

            if (t.jenis === "masuk") {
                masukData[m] += nom;
            } else if (t.jenis === "keluar") {
                keluarData[m] += nom;
            }
        });

        return { masukData, keluarData };
    }

    const initialData = calculateMonthlyData("all");
    const chartCtx = document.getElementById("grafikKeuanganCanvas").getContext("2d");

    const financeChart = new Chart(chartCtx, {
        type: "bar",
        data: {
            labels: monthLabels,
            datasets: [
                {
                    label: "Pemasukan",
                    data: initialData.masukData,
                    backgroundColor: "#059669",
                    borderColor: "#059669",
                    borderRadius: 4,
                    borderWidth: 1,
                    maxBarThickness: 16
                },
                {
                    label: "Pengeluaran",
                    data: initialData.keluarData,
                    backgroundColor: "#ef4444",
                    borderColor: "#ef4444",
                    borderRadius: 4,
                    borderWidth: 1,
                    maxBarThickness: 16
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function (ctx) {
                            const val = ctx.raw || 0;
                            return " " + ctx.dataset.label + ": Rp " + Number(val).toLocaleString("id-ID");
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: {
                        display: false
                    },
                    ticks: {
                        font: { size: 11, family: 'Inter' },
                        color: "#64748b"
                    }
                },
                y: {
                    beginAtZero: true,
                    grid: {
                        color: "#f1f5f9"
                    },
                    ticks: {
                        font: { size: 11, family: 'Inter' },
                        color: "#64748b",
                        callback: function (val) {
                            if (val >= 1000000) return (val / 1000000) + "jt";
                            if (val >= 1000) return (val / 1000) + "rb";
                            return val;
                        }
                    }
                }
            }
        }
    });

    yearSelect.addEventListener("change", function () {
        const filtered = calculateMonthlyData(this.value);
        financeChart.data.datasets[0].data = filtered.masukData;
        financeChart.data.datasets[1].data = filtered.keluarData;
        financeChart.update();
    });

    // =======================================================
    // 2. LOGIKA FILTER FRONTEND INTERAKTIF
    // =======================================================
    const filterJenisData = document.getElementById("filterJenisData");
    const filterMetode = document.getElementById("filterMetode");
    const colTableUang = document.getElementById("colTableUang");
    const colTableDonasi = document.getElementById("colTableDonasi");
    const colTableAset = document.getElementById("colTableAset");

    function updateFilterInteractivity() {
        const val = filterJenisData.value;

        // Aturan Metode Pembayaran: Hanya aktif jika Jenis Data = Transaksi Uang
        if (val === "uang") {
            filterMetode.disabled = false;
            filterMetode.style.opacity = "1";
        } else {
            filterMetode.disabled = true;
            filterMetode.style.opacity = "0.55";
            filterMetode.value = "semua";
        }

        // Tampilan kolom tabel sesuai pilihan Jenis Data
        if (val === "semua") {
            colTableUang.style.display = "";
            colTableDonasi.style.display = "";
            colTableAset.style.display = "";
            colTableUang.className = "col-12 col-xl-4 col-lg-4 table-column";
            colTableDonasi.className = "col-12 col-xl-4 col-lg-4 table-column";
            colTableAset.className = "col-12 col-xl-4 col-lg-4 table-column";
        } else if (val === "uang") {
            colTableUang.style.display = "";
            colTableDonasi.style.display = "none";
            colTableAset.style.display = "none";
            colTableUang.className = "col-12 table-column";
        } else if (val === "donasi") {
            colTableUang.style.display = "none";
            colTableDonasi.style.display = "";
            colTableAset.style.display = "none";
            colTableDonasi.className = "col-12 table-column";
        } else if (val === "aset") {
            colTableUang.style.display = "none";
            colTableDonasi.style.display = "none";
            colTableAset.style.display = "";
            colTableAset.className = "col-12 table-column";
        }

        // Reset pagination ke halaman 1 saat filter berubah
        if (window.paginationUang) window.paginationUang.goToPage(1);
        if (window.paginationDonasi) window.paginationDonasi.goToPage(1);
        if (window.paginationAset) window.paginationAset.goToPage(1);
    }

    filterJenisData.addEventListener("change", updateFilterInteractivity);

    filterMetode.addEventListener("change", function () {
        if (window.paginationUang) {
            window.paginationUang.setFilterMetode(this.value);
            window.paginationUang.goToPage(1);
        }
    });

    // Inisialisasi awal
    updateFilterInteractivity();

    // =======================================================
    // 3. PAGINATION KONTROL INDEPENDEN UNTUK KETIGA TABEL
    // =======================================================
    class TablePaginator {
        constructor(config) {
            this.tableBody = document.getElementById(config.tbodyId);
            this.infoEl = document.getElementById(config.infoId);
            this.navEl = document.getElementById(config.navId);
            this.pageSizeSelect = document.getElementById(config.pageSizeId);
            this.filterMetodeVal = "semua";
            this.currentPage = 1;
            this.pageSize = 10;

            this.allRows = Array.from(this.tableBody.querySelectorAll("tr"));
            this.init();
        }

        init() {
            if (this.pageSizeSelect) {
                this.pageSizeSelect.addEventListener("change", (e) => {
                    const v = e.target.value;
                    this.pageSize = (v === "all") ? 999999 : parseInt(v);
                    this.goToPage(1);
                });
            }
            this.render();
        }

        setFilterMetode(metode) {
            this.filterMetodeVal = metode.toLowerCase();
        }

        getVisibleRows() {
            return this.allRows.filter(row => {
                if (this.filterMetodeVal !== "semua" && row.dataset.metode) {
                    return row.dataset.metode === this.filterMetodeVal;
                }
                return true;
            });
        }

        goToPage(page) {
            this.currentPage = page;
            this.render();
        }

        render() {
            const activeRows = this.getVisibleRows();
            const total = activeRows.length;
            const totalPages = Math.max(1, Math.ceil(total / this.pageSize));

            if (this.currentPage > totalPages) this.currentPage = totalPages;
            if (this.currentPage < 1) this.currentPage = 1;

            const startIdx = (this.currentPage - 1) * this.pageSize;
            const endIdx = startIdx + this.pageSize;

            // Tampilkan atau sembunyikan baris
            this.allRows.forEach(r => r.style.display = "none");
            activeRows.slice(startIdx, endIdx).forEach(r => r.style.display = "");

            // Update info text
            if (total === 0) {
                this.infoEl.textContent = "Menampilkan 0 data";
            } else {
                const displayStart = startIdx + 1;
                const displayEnd = Math.min(endIdx, total);
                this.infoEl.textContent = `Menampilkan ${displayStart}–${displayEnd} dari ${total} data`;
            }

            // Render navigation buttons
            this.navEl.innerHTML = "";

            if (totalPages > 1) {
                // Prev btn
                const prevBtn = document.createElement("button");
                prevBtn.className = "btn-page-step";
                prevBtn.innerHTML = "<i class='bi bi-chevron-left'></i>";
                prevBtn.disabled = (this.currentPage === 1);
                prevBtn.addEventListener("click", () => this.goToPage(this.currentPage - 1));
                this.navEl.appendChild(prevBtn);

                // Page numbers (max 5 page buttons)
                let startPage = Math.max(1, this.currentPage - 2);
                let endPage = Math.min(totalPages, startPage + 4);
                if (endPage - startPage < 4) {
                    startPage = Math.max(1, endPage - 4);
                }

                for (let i = startPage; i <= endPage; i++) {
                    const pageBtn = document.createElement("button");
                    pageBtn.className = "btn-page-step" + (i === this.currentPage ? " active" : "");
                    pageBtn.textContent = i;
                    pageBtn.addEventListener("click", () => this.goToPage(i));
                    this.navEl.appendChild(pageBtn);
                }

                // Next btn
                const nextBtn = document.createElement("button");
                nextBtn.className = "btn-page-step";
                nextBtn.innerHTML = "<i class='bi bi-chevron-right'></i>";
                nextBtn.disabled = (this.currentPage === totalPages);
                nextBtn.addEventListener("click", () => this.goToPage(this.currentPage + 1));
                this.navEl.appendChild(nextBtn);
            }
        }
    }

    // Inisialisasi masing-masing tabel
    window.paginationUang = new TablePaginator({
        tbodyId: "tbodyUang",
        infoId: "infoUang",
        navId: "navUang",
        pageSizeId: "pageSizeUang"
    });

    window.paginationDonasi = new TablePaginator({
        tbodyId: "tbodyDonasi",
        infoId: "infoDonasi",
        navId: "navDonasi",
        pageSizeId: "pageSizeDonasi"
    });

    window.paginationAset = new TablePaginator({
        tbodyId: "tbodyAset",
        infoId: "infoAset",
        navId: "navAset",
        pageSizeId: "pageSizeAset"
    });

    // =======================================================
    // 4. DIALOG EKSPOR LAPORAN (PDF & EXCEL)
    // =======================================================
    (function () {
        const modalEl = document.getElementById("modalExportDialog");
        if (!modalEl) return;

        const formatRadioPdf = document.getElementById("exportFormatPdf");
        const formatRadioExcel = document.getElementById("exportFormatExcel");
        const formatCardPdf = document.getElementById("formatCardPdf");
        const formatCardExcel = document.getElementById("formatCardExcel");

        const inputMulai = document.getElementById("exportTanggalMulai");
        const inputSampai = document.getElementById("exportTanggalSampai");
        const btnResetDates = document.getElementById("btnResetExportDates");

        const selectJenisData = document.getElementById("exportJenisData");
        const selectMetode = document.getElementById("exportMetode");
        const alertError = document.getElementById("exportAlertError");
        const alertErrorText = document.getElementById("exportAlertErrorText");

        const btnSubmit = document.getElementById("btnSubmitExport");
        const btnSubmitText = document.getElementById("btnSubmitExportText");

        let currentFormat = "pdf";

        function setFormat(fmt) {
            currentFormat = (fmt === "excel") ? "excel" : "pdf";
            if (currentFormat === "pdf") {
                formatRadioPdf.checked = true;
                formatCardPdf.classList.add("active-format-pdf");
                formatCardExcel.classList.remove("active-format-excel");
                btnSubmit.className = "btn btn-danger btn-sm px-4 fw-semibold";
                btnSubmitText.innerHTML = '<i class="bi bi-file-earmark-pdf-fill me-1"></i> Unduh PDF';
            } else {
                formatRadioExcel.checked = true;
                formatCardExcel.classList.add("active-format-excel");
                formatCardPdf.classList.remove("active-format-pdf");
                btnSubmit.className = "btn btn-success btn-sm px-4 fw-semibold";
                btnSubmitText.innerHTML = '<i class="bi bi-file-earmark-excel-fill me-1"></i> Unduh Excel';
            }
        }

        // Klik format card
        formatCardPdf.addEventListener("click", () => setFormat("pdf"));
        formatCardExcel.addEventListener("click", () => setFormat("excel"));

        // Toggle metode pembayaran sesuai jenis data
        function updateMetodeStatus() {
            const isUang = (selectJenisData.value === "uang");
            selectMetode.disabled = !isUang;
            selectMetode.style.opacity = isUang ? "1" : "0.55";
            if (!isUang) {
                selectMetode.value = "semua";
            }
        }

        selectJenisData.addEventListener("change", updateMetodeStatus);

        // Reset dates
        btnResetDates.addEventListener("click", function () {
            inputMulai.value = "";
            inputSampai.value = "";
            hideError();
        });

        function showError(msg) {
            alertErrorText.textContent = msg;
            alertError.classList.remove("d-none");
            alertError.classList.add("d-flex");
        }

        function hideError() {
            alertError.classList.remove("d-flex");
            alertError.classList.add("d-none");
        }

        inputMulai.addEventListener("input", hideError);
        inputSampai.addEventListener("input", hideError);

        // Prefill modal saat dibuka
        modalEl.addEventListener("show.bs.modal", function (event) {
            hideError();

            // Cek data-format dari tombol trigger
            const triggerBtn = event.relatedTarget;
            const targetFormat = triggerBtn && triggerBtn.getAttribute("data-format");
            setFormat(targetFormat || currentFormat);

            // Prefill dari filter halaman jika ada
            const pageFilterMulai = document.getElementById("filterMulai");
            const pageFilterSampai = document.getElementById("filterSampai");
            const pageFilterJenis = document.getElementById("filterJenisData");
            const pageFilterMetode = document.getElementById("filterMetode");

            if (pageFilterMulai && pageFilterMulai.value) {
                inputMulai.value = pageFilterMulai.value;
            }
            if (pageFilterSampai && pageFilterSampai.value) {
                inputSampai.value = pageFilterSampai.value;
            }
            if (pageFilterJenis && pageFilterJenis.value) {
                selectJenisData.value = pageFilterJenis.value;
            }
            updateMetodeStatus();
            if (pageFilterMetode && pageFilterMetode.value && selectJenisData.value === "uang") {
                selectMetode.value = pageFilterMetode.value;
            }
        });

        // Submit export
        btnSubmit.addEventListener("click", function () {
            const mulai = (inputMulai.value || "").trim();
            const sampai = (inputSampai.value || "").trim();

            // Validasi tanggal: jika keduanya diisi, mulai tidak boleh > sampai
            if (mulai && sampai && mulai > sampai) {
                showError("Tanggal awal (" + mulai + ") tidak boleh lebih besar dari tanggal akhir (" + sampai + ").");
                return;
            }
            hideError();

            const jenisData = selectJenisData.value;
            const metode = (jenisData === "uang") ? selectMetode.value : "semua";

            // Disable button dan tampilkan spinner indikator loading
            const originalContent = btnSubmit.innerHTML;
            btnSubmit.disabled = true;
            btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Menyiapkan Berkas...';

            const params = new URLSearchParams();
            if (mulai) params.append("mulai", mulai);
            if (sampai) params.append("sampai", sampai);
            if (jenisData && jenisData !== "semua") params.append("jenisData", jenisData);
            if (metode && metode !== "semua") params.append("metode", metode);

            const queryString = params.toString();
            const downloadUrl = "/laporan/" + currentFormat + (queryString ? "?" + queryString : "");

            // Unduh file secara otomatis
            const downloadLink = document.createElement("a");
            downloadLink.href = downloadUrl;
            downloadLink.setAttribute("download", "");
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);

            // Re-enable tombol setelah 2.5 detik
            setTimeout(function () {
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = originalContent;
            }, 2500);
        });

        // Auto open jika URL parameter meminta openExport
        if (window.location.search.includes("openExport=true") || window.location.hash === "#exportModal") {
            const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
            modalInstance.show();
        }

        if (window.location.hash === "#modalInventarisAset") {
            const modalAsetEl = document.getElementById("modalInventarisAset");
            if (modalAsetEl) {
                const m = bootstrap.Modal.getOrCreateInstance(modalAsetEl);
                m.show();
            }
        }

        if (window.location.search.includes("openQris=true") || window.location.hash === "#modalZoomQris") {
            const modalQrisEl = document.getElementById("modalZoomQris");
            if (modalQrisEl) {
                const mq = bootstrap.Modal.getOrCreateInstance(modalQrisEl);
                mq.show();
            }
        }

        // =======================================================
        // 5. AUTOCOMPLETE MASTER BLOK & FORM SARAN MASUKAN WARGA
        // =======================================================
        (function initSaranMasukan() {
            let cachedMasterBlok = [];
            let activeSuggestionIndex = -1;
            let currentSuggestions = [];

            const inputBlok = document.getElementById("inputSaranBlok");
            const hiddenBlok = document.getElementById("hiddenSelectedBlok");
            const dropdown = document.getElementById("saranBlokDropdown");
            const listContainer = document.getElementById("saranBlokList");
            const countBadge = document.getElementById("saranBlokMatchCount");
            const toggleBtn = document.getElementById("btnToggleBlokList");
            const validationFeedback = document.getElementById("blokValidationFeedback");

            const form = document.getElementById("formSaranMasukan");
            const inputNama = document.getElementById("inputSaranNama");
            const selectKategori = document.getElementById("selectSaranKategori");
            const textareaPesan = document.getElementById("textareaSaranPesan");
            const charCounter = document.getElementById("saranCharCounter");
            const alertBox = document.getElementById("saranAlertBox");
            const submitBtn = document.getElementById("btnSubmitSaran");
            const submitSpinner = document.getElementById("btnSubmitSaranSpinner");
            const submitText = document.getElementById("btnSubmitSaranText");
            const modalSaranEl = document.getElementById("modalSaranMasukan");

            if (!inputBlok || !form) return;

            // Memuat master data blok dari database secara dinamis
            async function loadMasterBlok() {
                try {
                    const res = await fetch("/api/master-blok");
                    const json = await res.json();
                    if (json && json.success && Array.isArray(json.data)) {
                        cachedMasterBlok = json.data;
                        // Perbarui label jumlah blok resmi secara dinamis dari database
                        const labelEl = document.getElementById("labelTotalBlokText");
                        if (labelEl) {
                            labelEl.textContent = json.total || json.data.length;
                        }
                    }
                } catch (err) {
                    console.error("Gagal memuat master blok:", err);
                }
                return cachedMasterBlok;
            }

            // Saat modal dibuka: muat master blok, reset alert, dan sembunyikan FAB agar tidak tumpuk
            const fabSaran = document.querySelector(".btn-fab-saran");
            if (modalSaranEl) {
                modalSaranEl.addEventListener("show.bs.modal", function () {
                    loadMasterBlok();
                    hideAlert();
                    if (fabSaran) {
                        fabSaran.style.setProperty("display", "none", "important");
                    }
                });

                // Saat modal ditutup: tampilkan kembali FAB
                modalSaranEl.addEventListener("hidden.bs.modal", function () {
                    if (fabSaran) {
                        fabSaran.style.removeProperty("display");
                    }
                });
            }

            // Filter sugesti blok berdasarkan input
            function filterBlocks(rawQuery) {
                if (!cachedMasterBlok || cachedMasterBlok.length === 0) return [];
                const q = String(rawQuery || "").trim().toUpperCase();
                if (!q) return cachedMasterBlok;

                const prefixMatches = cachedMasterBlok.filter(b => b.startsWith(q));
                const containsMatches = cachedMasterBlok.filter(b => !b.startsWith(q) && b.includes(q));
                return [...prefixMatches, ...containsMatches];
            }

            // Render daftar sugesti dropdown
            function renderSuggestions(matches, query) {
                currentSuggestions = matches;
                activeSuggestionIndex = -1;
                listContainer.innerHTML = "";

                const q = String(query || "").trim().toUpperCase();

                if (!matches || matches.length === 0) {
                    countBadge.textContent = "0 cocok";
                    countBadge.className = "badge bg-danger";
                    listContainer.innerHTML = `
                        <div class="autocomplete-empty py-3 text-center text-muted">
                            <i class="bi bi-exclamation-triangle text-warning fs-5 d-block mb-1"></i>
                            <span class="text-danger fw-semibold">Blok "${q}" tidak ditemukan.</span>
                            <div class="small mt-1 text-secondary">Pastikan memilih dari daftar blok resmi terdaftar.</div>
                        </div>
                    `;
                    dropdown.classList.remove("d-none");
                    return;
                }

                countBadge.textContent = matches.length + " cocok";
                countBadge.className = "badge bg-success";

                matches.forEach((code, idx) => {
                    const item = document.createElement("div");
                    item.className = "autocomplete-item";
                    item.setAttribute("role", "option");
                    item.setAttribute("data-index", idx);
                    item.setAttribute("data-code", code);

                    let displayHtml = code;
                    if (q && code.includes(q)) {
                        const sIdx = code.indexOf(q);
                        const before = code.slice(0, sIdx);
                        const matched = code.slice(sIdx, sIdx + q.length);
                        const after = code.slice(sIdx + q.length);
                        displayHtml = `${before}<strong class="text-success border-bottom border-success border-2">${matched}</strong>${after}`;
                    }

                    item.innerHTML = `
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light text-dark font-monospace fw-bold border">${displayHtml}</span>
                            <span class="small text-muted">Blok Resmi ${code}</span>
                        </div>
                        <i class="bi bi-check2 text-success ${hiddenBlok.value === code ? '' : 'd-none'}"></i>
                    `;

                    // Klik atau sentuh item
                    item.addEventListener("mousedown", function (e) {
                        e.preventDefault();
                        selectBlock(code);
                    });

                    listContainer.appendChild(item);
                });

                dropdown.classList.remove("d-none");
            }

            function selectBlock(code) {
                inputBlok.value = code;
                hiddenBlok.value = code;
                inputBlok.classList.remove("is-invalid");
                inputBlok.classList.add("is-valid");
                validationFeedback.style.setProperty("display", "none", "important");
                dropdown.classList.add("d-none");
                activeSuggestionIndex = -1;
            }

            // Event input teks
            inputBlok.addEventListener("input", async function () {
                await loadMasterBlok();
                const q = this.value.trim().toUpperCase();

                if (hiddenBlok.value && hiddenBlok.value !== q) {
                    hiddenBlok.value = "";
                    inputBlok.classList.remove("is-valid");
                }

                const matches = filterBlocks(q);
                renderSuggestions(matches, q);
            });

            // Event fokus pada input
            inputBlok.addEventListener("focus", async function () {
                await loadMasterBlok();
                const matches = filterBlocks(this.value);
                renderSuggestions(matches, this.value);
            });

            // Event blur
            inputBlok.addEventListener("blur", function () {
                setTimeout(() => {
                    dropdown.classList.add("d-none");
                    validateBlokSelection();
                }, 200);
            });

            // Tombol buka seluruh daftar
            if (toggleBtn) {
                toggleBtn.addEventListener("click", async function () {
                    await loadMasterBlok();
                    if (dropdown.classList.contains("d-none")) {
                        inputBlok.focus();
                        const matches = filterBlocks(inputBlok.value);
                        renderSuggestions(matches, inputBlok.value);
                    } else {
                        dropdown.classList.add("d-none");
                    }
                });
            }

            // Navigasi Keyboard (ArrowDown, ArrowUp, Enter, Escape)
            inputBlok.addEventListener("keydown", function (e) {
                if (dropdown.classList.contains("d-none")) {
                    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                        const matches = filterBlocks(this.value);
                        renderSuggestions(matches, this.value);
                        e.preventDefault();
                        return;
                    }
                }

                const items = listContainer.querySelectorAll(".autocomplete-item");
                if (items.length === 0) return;

                if (e.key === "ArrowDown") {
                    e.preventDefault();
                    activeSuggestionIndex = (activeSuggestionIndex + 1) % items.length;
                    updateActiveSuggestion(items);
                } else if (e.key === "ArrowUp") {
                    e.preventDefault();
                    activeSuggestionIndex = (activeSuggestionIndex - 1 + items.length) % items.length;
                    updateActiveSuggestion(items);
                } else if (e.key === "Enter") {
                    if (activeSuggestionIndex >= 0 && activeSuggestionIndex < currentSuggestions.length) {
                        e.preventDefault();
                        selectBlock(currentSuggestions[activeSuggestionIndex]);
                    }
                } else if (e.key === "Escape") {
                    dropdown.classList.add("d-none");
                }
            });

            function updateActiveSuggestion(items) {
                items.forEach((it, idx) => {
                    if (idx === activeSuggestionIndex) {
                        it.classList.add("active");
                        it.scrollIntoView({ block: "nearest" });
                    } else {
                        it.classList.remove("active");
                    }
                });
            }

            function validateBlokSelection() {
                const val = inputBlok.value.trim().toUpperCase();
                if (!val || val !== hiddenBlok.value || !cachedMasterBlok.includes(val)) {
                    hiddenBlok.value = "";
                    inputBlok.classList.remove("is-valid");
                    inputBlok.classList.add("is-invalid");
                    validationFeedback.style.setProperty("display", "block", "important");
                    return false;
                } else {
                    inputBlok.classList.remove("is-invalid");
                    inputBlok.classList.add("is-valid");
                    validationFeedback.style.setProperty("display", "none", "important");
                    return true;
                }
            }

            // Hitung karakter pesan
            if (textareaPesan && charCounter) {
                textareaPesan.addEventListener("input", function () {
                    const len = this.value.length;
                    charCounter.textContent = `${len} / 2000`;
                    if (len > 1900) charCounter.classList.add("text-danger");
                    else charCounter.classList.remove("text-danger");
                });
            }

            function showAlert(type, msg) {
                alertBox.className = `alert alert-${type} alert-dismissible fade show`;
                alertBox.innerHTML = `
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi ${type === 'success' ? 'bi-check-circle-fill fs-5' : 'bi-exclamation-triangle-fill fs-5'}"></i>
                        <div>${msg}</div>
                    </div>
                    <button type="button" class="btn-close" onclick="document.getElementById('saranAlertBox').classList.add('d-none')"></button>
                `;
                alertBox.classList.remove("d-none");
            }

            function hideAlert() {
                alertBox.classList.add("d-none");
            }

            // Submit formulir saran & masukan
            form.addEventListener("submit", async function (e) {
                e.preventDefault();
                hideAlert();

                const nama = inputNama.value.trim();
                const blokValid = validateBlokSelection();
                const kategori = selectKategori.value;
                const pesan = textareaPesan.value.trim();

                if (!nama || nama.length < 2) {
                    inputNama.classList.add("is-invalid");
                    inputNama.focus();
                    showAlert("danger", "Nama lengkap wajib diisi minimal 2 karakter.");
                    return;
                } else {
                    inputNama.classList.remove("is-invalid");
                }

                if (!blokValid) {
                    inputBlok.focus();
                    const matches = filterBlocks(inputBlok.value);
                    renderSuggestions(matches, inputBlok.value);
                    showAlert("danger", "Silakan pilih kode blok resmi dari daftar sugesti dropdown.");
                    return;
                }

                if (!kategori) {
                    selectKategori.classList.add("is-invalid");
                    selectKategori.focus();
                    showAlert("danger", "Silakan pilih salah satu kategori masukan.");
                    return;
                } else {
                    selectKategori.classList.remove("is-invalid");
                }

                if (!pesan || pesan.length < 5) {
                    textareaPesan.classList.add("is-invalid");
                    textareaPesan.focus();
                    showAlert("danger", "Pesan atau masukan wajib diisi minimal 5 karakter.");
                    return;
                } else {
                    textareaPesan.classList.remove("is-invalid");
                }

                // Proteksi pengiriman ganda (disable button + spinner)
                submitBtn.disabled = true;
                submitSpinner.classList.remove("d-none");
                submitText.innerHTML = "Mengirim...";

                try {
                    const res = await fetch("/api/saran", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            nama: nama,
                            blok: hiddenBlok.value,
                            kategori: kategori,
                            pesan: pesan
                        })
                    });

                    const json = await res.json();

                    if (res.ok && json.success) {
                        showAlert("success", `<strong>Alhamdulillah!</strong> ${json.message}`);
                        form.reset();
                        hiddenBlok.value = "";
                        inputBlok.classList.remove("is-valid");
                        if (charCounter) charCounter.textContent = "0 / 2000";

                        setTimeout(() => {
                            const inst = bootstrap.Modal.getInstance(modalSaranEl);
                            if (inst) inst.hide();
                            hideAlert();
                        }, 3000);
                    } else {
                        showAlert("danger", json.error || "Gagal mengirim masukan. Pastikan data yang dimasukkan valid.");
                    }
                } catch (netErr) {
                    console.error("Network error kirim saran:", netErr);
                    showAlert("danger", "Terjadi gangguan jaringan ke server. Silakan coba kembali sesaat lagi.");
                } finally {
                    submitBtn.disabled = false;
                    submitSpinner.classList.add("d-none");
                    submitText.innerHTML = '<i class="bi bi-send-fill me-1"></i> Kirim Masukan';
                }
            });

            // Buka modal otomatis jika requested lewat URL
            if (window.location.search.includes("openSaran=true") || window.location.hash === "#modalSaranMasukan") {
                const inst = bootstrap.Modal.getOrCreateInstance(modalSaranEl);
                inst.show();
                const qParam = new URLSearchParams(window.location.search).get("qBlok");
                if (qParam) {
                    setTimeout(() => {
                        inputBlok.value = qParam;
                        inputBlok.focus();
                        inputBlok.dispatchEvent(new Event("input", { bubbles: true }));
                    }, 500);
                }
            }
        })();
    })();
</script>

<!-- FLOATING ACTION BUTTON (FAB) SARAN & MASUKAN -->
<button type="button" class="btn-fab-saran shadow-lg" data-bs-toggle="modal" data-bs-target="#modalSaranMasukan" title="Kirim Saran & Masukan Warga">
    <i class="bi bi-chat-heart-fill"></i>
    <span class="fab-label d-none d-sm-inline">Kotak Saran Warga</span>
</button>

</body>

</html>