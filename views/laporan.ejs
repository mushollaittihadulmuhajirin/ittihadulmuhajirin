                        Rp <%= formatRupiahTampilan(currentSaldoTunai, false) %>
                    </div>
                    <div class="summary-subtext">Kas &amp; Dompet</div>
                </div>
            </div>
        </div>

        <!-- Kartu 5: Saldo Non-Tunai -->
        <div class="summary-card">
            <div class="summary-card-inner">
                <div class="summary-icon-square icon-nontunai">
                    <i class="bi bi-bank"></i>
                </div>
                <div class="summary-info">
                    <div class="summary-title">Saldo Non-Tunai</div>
                    <div class="summary-amount amount-nontunai" title="Rp <%= formatRupiahTampilan(currentSaldoNonTunai, true) %>">
                        Rp <%= formatRupiahTampilan(currentSaldoNonTunai, true) %>
                    </div>
                    <div class="summary-subtext">Mandiri</div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2.5. PANEL INFORMASI REKENING & DONASI (BANK MANDIRI & QRIS) -->
    <% if (typeof pengaturanDonasi !== 'undefined' && pengaturanDonasi && pengaturanDonasi.tampil_panel) { %>
    <section class="donation-section" aria-label="Informasi Rekening & Donasi">
        <div class="donation-header d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center gap-2">
                <div class="donation-header-icon">
                    <i class="bi bi-wallet-fill"></i>
                </div>
                <div>
                    <h3 class="donation-header-title mb-0"><%= pengaturanDonasi.judul_panel || 'Informasi Rekening & Donasi' %></h3>
                    <p class="donation-header-sub mb-0">Salurkan infak dan sedekah untuk operasional dan pembangunan Masjid Ghoiru Jami' Ittihadul Muhajirin</p>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <!-- SISI KIRI: TRANSFER BANK MANDIRI -->
            <% if (pengaturanDonasi.tampil_bank) { %>
            <div class="col-12 <%= pengaturanDonasi.tampil_qris ? 'col-lg-6' : 'col-lg-12' %>">
                <div class="donation-card bank-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="donation-card-badge">
                            <i class="bi bi-bank2"></i> Transfer Bank Mandiri
                        </div>
                        <div class="bank-logo-badge">
                            <i class="bi bi-credit-card-2-front-fill"></i>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="bank-name-label">Nama Bank</div>
                        <div class="bank-name-val">Bank <%= pengaturanDonasi.bank_nama || 'Mandiri' %></div>
                    </div>

                    <div class="bank-account-box mb-3">
                        <div class="account-num-label">Nomor Rekening</div>
                        <div class="account-num-row d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <span class="account-num-text" id="nomorRekeningDisplay"><%= pengaturanDonasi.bank_rekening || '1220013513869' %></span>
                            <button type="button" class="btn btn-copy-account" id="btnSalinMandiri" onclick="salinNomorRekening('<%= pengaturanDonasi.bank_rekening || '1220013513869' %>', this)">
                                <i class="bi bi-clipboard"></i> Salin
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="holder-label">Atas Nama</div>
                        <div class="holder-val"><%= pengaturanDonasi.bank_atas_nama || 'Muhammad Riyadi' %></div>
                    </div>

                    <div class="bank-note">
                        <i class="bi bi-shield-check text-success me-1"></i> Mohon pastikan nama rekening tujuan adalah <strong><%= pengaturanDonasi.bank_atas_nama || 'Muhammad Riyadi' %></strong> saat konfirmasi transfer.
                    </div>
                </div>
            </div>
            <% } %>

            <!-- SISI KANAN: DONASI MELALUI QRIS -->
            <% if (pengaturanDonasi.tampil_qris) { %>
            <div class="col-12 <%= pengaturanDonasi.tampil_bank ? 'col-lg-6' : 'col-lg-12' %>">
                <div class="donation-card qris-card h-100">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                        <div class="donation-card-badge">
                            <i class="bi bi-qr-code-scan"></i> <%= pengaturanDonasi.qris_judul || 'Donasi melalui QRIS' %>
                        </div>
                        <span class="badge <%= (pengaturanDonasi.qris_status === 'Aktif') ? 'bg-success' : 'bg-warning text-dark' %>">
                            <i class="bi <%= (pengaturanDonasi.qris_status === 'Aktif') ? 'bi-check-circle-fill' : 'bi-clock-history' %> me-1"></i><%= pengaturanDonasi.qris_status || 'Menunggu QRIS resmi' %>
                        </span>
                    </div>

                    <p class="qris-instruction mb-3">
                        <%= pengaturanDonasi.qris_petunjuk || 'Pindai kode QR untuk berdonasi dengan aplikasi pembayaran yang mendukung QRIS.' %>
                    </p>

                    <div class="d-flex flex-column flex-sm-row align-items-center gap-3">
                        <!-- GAMBAR QRIS (DAPAT DIPERBESAR) -->
                        <div class="qris-image-container" onclick="bukaModalZoomQris()" title="Klik untuk memperbesar gambar QRIS">
                            <img src="<%= pengaturanDonasi.qris_gambar || '/images/qris/qris-mushola-al-muhajirin.jpg' %>" alt="QRIS Mushola Al Muhajirin" class="qris-img" onerror="this.onerror=null; this.src='/images/qris/qris-mushola-al-muhajirin.jpg';">
                            <div class="qris-zoom-overlay">
                                <i class="bi bi-zoom-in me-1"></i>Perbesar
                            </div>
                        </div>

                        <!-- DETAIL MERCHANT, NMID & STATUS -->
                        <div class="qris-meta-col flex-grow-1 w-100">
                            <div class="mb-2">
                                <div class="qris-meta-label">Nama Merchant</div>
                                <div class="qris-meta-val"><%= pengaturanDonasi.qris_merchant || 'MUSHOLA AL MUHAJIRIN' %></div>
                            </div>
                            <div class="mb-2">
                                <div class="qris-meta-label">NMID</div>
                                <div class="qris-meta-val font-monospace"><%= pengaturanDonasi.qris_nmid || 'ID1024347808734' %></div>
                            </div>

                            <div class="qris-status-box <%= (pengaturanDonasi.qris_status === 'Aktif') ? 'qris-status-aktif' : 'qris-status-menunggu' %> mt-2">
                                <div class="qris-status-desc">
                                    <i class="bi <%= (pengaturanDonasi.qris_status === 'Aktif') ? 'bi-check2' : 'bi-info-circle-fill' %> me-1"></i>
                                    <%= pengaturanDonasi.qris_keterangan_status || 'QRIS belum diaktifkan untuk pembayaran sampai status dan keabsahannya dikonfirmasi oleh pengelola.' %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
    </section>
    <% } %>

    <!-- 3. GRAFIK KEUANGAN & PANEL EXPORT (SIDE-BY-SIDE DESKTOP) -->
    <div class="row g-3 chart-export-row">
        <!-- Grafik Keuangan (Col-lg-8) -->
        <div class="col-12 col-lg-8">
            <div class="content-card">
                <div class="content-card-header">
                    <h3 class="content-card-title">
                        <i class="bi bi-bar-chart-fill text-success"></i> Grafik Keuangan
                    </h3>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-event text-muted small"></i>
                        <select id="chartYearFilter" class="form-select form-select-sm" style="width: auto; font-size: 0.8rem; border-radius: 8px;">
                            <option value="all">Semua Tahun</option>
                        </select>
                    </div>
                </div>
                <div class="content-card-body">
                    <div class="d-flex justify-content-center mb-3">
                        <div class="chart-legend-box">
                            <div><span class="legend-indicator legend-masuk"></span> Pemasukan</div>
                            <div><span class="legend-indicator legend-keluar"></span> Pengeluaran</div>
                        </div>
                    </div>
                    <div style="position: relative; height: 260px; width: 100%;">
                        <canvas id="grafikKeuanganCanvas"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Export & Arsip Laporan (Col-lg-4) -->
        <div class="col-12 col-lg-4">
            <div class="content-card">
                <div class="content-card-header">
                    <h3 class="content-card-title">
                        <i class="bi bi-file-earmark-text text-danger"></i> Export &amp; Arsip Laporan
                    </h3>
                </div>
                <div class="content-card-body d-flex flex-column justify-content-between">
                    <p class="text-muted small mb-3">
                        Download laporan keuangan atau buka arsip lama DKM.
                    </p>
                    <div class="export-btn-group">
                        <button type="button" class="btn-export-custom btn-pdf" id="btnExportPdfModal" data-bs-toggle="modal" data-bs-target="#modalExportDialog" data-format="pdf">
                            <i class="bi bi-file-earmark-pdf-fill"></i> <span class="d-none d-sm-inline">Export </span>PDF
                        </button>
                        <button type="button" class="btn-export-custom btn-excel" id="btnExportExcelModal" data-bs-toggle="modal" data-bs-target="#modalExportDialog" data-format="excel">
                            <i class="bi bi-file-earmark-excel-fill"></i> <span class="d-none d-sm-inline">Export </span>Excel
                        </button>
                        <a href="https://drive.google.com/drive/folders/18wukyYZaaxThWp01WyIciawSdSJiQrjV" target="_blank" rel="noopener noreferrer" class="btn-export-custom btn-archive">
                            <i class="bi bi-folder-fill"></i> <span class="d-none d-sm-inline">Laporan </span><span class="d-sm-none">Arsip</span><span class="d-none d-sm-inline">Lama</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. FILTER LAPORAN -->
    <section class="filter-card">
        <h3 class="filter-title">
            <i class="bi bi-sliders text-success"></i> Filter Laporan
        </h3>
        <form method="GET" action="" id="filterForm">
            <div class="filter-form-row">
                <!-- Dropdown Jenis Data -->
                <div class="filter-col">
                    <label class="filter-label" for="filterJenisData">Jenis Data</label>
                    <select id="filterJenisData" class="filter-control">
                        <option value="semua">Semua</option>
                        <option value="uang">💰 Riwayat Transaksi Uang</option>
                        <option value="donasi">🎁 Data Donasi Barang</option>
                        <option value="aset">📦 Inventaris Masjid</option>
                    </select>
                </div>

                <!-- Dropdown Metode Pembayaran (Hanya aktif untuk Transaksi Uang) -->
                <div class="filter-col">
                    <label class="filter-label" for="filterMetode">Metode Pembayaran</label>
                    <select id="filterMetode" class="filter-control">
                        <option value="semua">Semua</option>
                        <option value="tunai">Tunai</option>
                        <option value="transfer">Transfer</option>
                    </select>
                </div>

                <!-- Tanggal Awal -->
                <div class="filter-col">
                    <label class="filter-label" for="filterMulai">Tanggal Awal</label>
                    <input type="date" name="mulai" id="filterMulai" class="filter-control" value="<%= mulai || '' %>">
                </div>

                <!-- Tanggal Akhir -->
                <div class="filter-col">
                    <label class="filter-label" for="filterSampai">Tanggal Akhir</label>
                    <input type="date" name="sampai" id="filterSampai" class="filter-control" value="<%= sampai || '' %>">
                </div>

                <!-- Tombol Action -->
                <div class="filter-col-btns">
                    <button type="submit" class="btn-filter-submit" id="btnFilterSubmit">
                        <i class="bi bi-search"></i> Tampilkan
                    </button>
                    <a href="javascript:void(0)" onclick="window.location.href=window.location.pathname" class="btn-filter-reset" id="btnFilterReset">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </a>
                </div>
            </div>
        </form>
    </section>

    <!-- 5. TIGA TABEL LAPORAN (BERDAMPINGAN DI DESKTOP / STACKED DI MOBILE) -->
    <section class="tables-grid" aria-label="Tabel Laporan">
        <div class="row g-3" id="tablesRow">

            <!-- TABEL A: RIWAYAT TRANSAKSI UANG -->
            <div class="col-12 col-xl-4 col-lg-4 table-column" id="colTableUang">
                <div class="report-table-card">
                    <div class="table-card-banner banner-uang">
                        <h4 class="banner-title">
                            💰 Riwayat Transaksi Uang
                        </h4>
                        <button type="button" class="btn-banner-link" data-bs-toggle="modal" data-bs-target="#modalTransaksiUang">
                            Lihat Semua <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>

                    <div class="table-custom-wrapper">
                        <table class="table-custom" id="tableUang">
                            <thead>
                                <tr>
                                    <th>📅 Tanggal</th>
                                    <th>📂 Kategori</th>
                                    <th>💳 Jenis</th>
                                    <th>🏦 Metode</th>
                                    <th class="text-end">💰 Nominal</th>
                                    <th>📝 Keterangan</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyUang">
                                <% if (Array.isArray(data) && data.length > 0) { %>
                                    <% data.forEach(function(item) { %>
                                        <tr data-metode="<%= String(item.metode || '').toLowerCase().trim() %>">
                                            <td>
                                                <%= new Date(item.tanggal).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }) %>
                                            </td>
                                            <td title="<%= item.kategori_nama || '-' %>">
                                                <%= item.kategori_nama || '-' %>
                                            </td>
                                            <td>
                                                <% if (item.jenis === 'masuk') { %>
                                                    <span class="badge-tipe-masuk">Pemasukan</span>
                                                <% } else { %>
                                                    <span class="badge-tipe-keluar">Pengeluaran</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (String(item.metode || '').toLowerCase() === 'tunai') { %>
                                                    <span class="badge-metode-tunai">Tunai</span>
                                                <% } else { %>
                                                    <span class="badge-metode-transfer">Transfer</span>
                                                <% } %>
                                            </td>
                                            <td class="text-end">
                                                <% if (item.jenis === 'masuk') { %>
                                                    <span class="val-masuk">+ Rp <%= Number(item.nominal || 0).toLocaleString('id-ID') %></span>
                                                <% } else { %>
                                                    <span class="val-keluar">- Rp <%= Number(item.nominal || 0).toLocaleString('id-ID') %></span>
                                                <% } %>
                                            </td>
                                            <td title="<%= item.keterangan || '-' %>" class="text-truncate-cell">
                                                <%= item.keterangan || '-' %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">Belum ada transaksi.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <div class="table-card-footer">
                        <span id="infoUang">Menampilkan 0 data</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="pagination-nav-group" id="navUang"></div>
                            <select id="pageSizeUang" class="page-size-select">
                                <option value="10">10 per halaman</option>
                                <option value="20">20 per halaman</option>
                                <option value="50">50 per halaman</option>
                                <option value="all">Semua</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABEL B: DATA DONASI BARANG -->
            <div class="col-12 col-xl-4 col-lg-4 table-column" id="colTableDonasi">
                <div class="report-table-card">
                    <div class="table-card-banner banner-donasi">
                        <h4 class="banner-title">
                            🎁 Data Donasi Barang
                        </h4>
                        <button type="button" class="btn-banner-link" data-bs-toggle="modal" data-bs-target="#modalDonasiBarang">
                            Lihat Semua <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>

                    <div class="table-custom-wrapper">
                        <table class="table-custom" id="tableDonasi">
                            <thead>
                                <tr>
                                    <th>📅 Tanggal</th>
                                    <th>👤 Nama Donatur</th>
                                    <th>📂 Kategori</th>
                                    <th>🎁 Nama Barang</th>
                                    <th>📦 Jumlah</th>
                                    <th>📝 Keterangan</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyDonasi">
                                <% if (Array.isArray(donasi) && donasi.length > 0) { %>
                                    <% donasi.forEach(function(item) { %>
                                        <tr>
                                            <td>
                                                <%= new Date(item.tanggal).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }) %>
                                            </td>
                                            <td title="<%= item.nama_donatur || '-' %>">
                                                <strong><%= item.nama_donatur || '-' %></strong>
                                            </td>
                                            <td title="<%= item.kategori || '-' %>">
                                                <%= item.kategori || '-' %>
                                            </td>
                                            <td title="<%= item.nama_barang || '-' %>">
                                                <%= item.nama_barang || '-' %>
                                            </td>
                                            <td>
                                                <strong><%= item.jumlah %></strong> <%= item.satuan || '' %>
                                            </td>
                                            <td title="<%= item.keterangan || '-' %>" class="text-truncate-cell">
                                                <%= item.keterangan || '-' %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">Belum ada donasi barang.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <div class="table-card-footer">
                        <span id="infoDonasi">Menampilkan 0 data</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="pagination-nav-group" id="navDonasi"></div>
                            <select id="pageSizeDonasi" class="page-size-select">
                                <option value="10">10 per halaman</option>
                                <option value="20">20 per halaman</option>
                                <option value="50">50 per halaman</option>
                                <option value="all">Semua</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABEL C: INVENTARIS MASJID -->
            <div class="col-12 col-xl-4 col-lg-4 table-column" id="colTableAset">
                <div class="report-table-card">
                    <div class="table-card-banner banner-aset">
                        <h4 class="banner-title">
                            📦 Inventaris Masjid
                        </h4>
                        <button type="button" class="btn-banner-link" data-bs-toggle="modal" data-bs-target="#modalInventarisAset">
                            Lihat Semua <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>

                    <div class="table-custom-wrapper">
                        <table class="table-custom" id="tableAset">
                            <thead>
                                <tr>
                                    <th>📅 Tanggal</th>
                                    <th>📦 Nama Barang</th>
                                    <th>📂 Kategori</th>
                                    <th>🔢 Jumlah</th>
                                    <th>📏 Satuan</th>
                                    <th>✅ Kondisi</th>
                                    <th class="text-end">💰 Nilai Estimasi</th>
                                    <th>📝 Keterangan</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyAset">
                                <% if (Array.isArray(aset) && aset.length > 0) { %>
                                    <% aset.forEach(function(item) { %>
                                        <tr>
                                            <td>
                                                <%= item.tanggal_masuk ? new Date(item.tanggal_masuk).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '-' %>
                                            </td>
                                            <td title="<%= item.nama_aset || '-' %>">
                                                <strong><%= item.nama_aset || '-' %></strong>
                                            </td>
                                            <td title="<%= item.kategori || '-' %>">
                                                <%= item.kategori || '-' %>
                                            </td>
                                            <td>
                                                <%= item.jumlah !== null && item.jumlah !== undefined ? item.jumlah : '-' %>
                                            </td>
                                            <td>
                                                <%= item.satuan || '-' %>
                                            </td>
                                            <td>
                                                <% if (item.kondisi) { %>
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border"><%= item.kondisi %></span>
                                                <% } else { %>
                                                    -
                                                <% } %>
                                            </td>
                                            <td class="text-end">
                                                <%= (item.nilai_estimasi && Number(item.nilai_estimasi) > 0) ? 'Rp ' + Number(item.nilai_estimasi).toLocaleString('id-ID') : '-' %>
                                            </td>
                                            <td title="<%= item.keterangan || '-' %>" class="text-truncate-cell">
                                                <%= item.keterangan || '-' %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">Belum ada inventaris aset.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <div class="table-card-footer">
                        <span id="infoAset">Menampilkan 0 data</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="pagination-nav-group" id="navAset"></div>
                            <select id="pageSizeAset" class="page-size-select">
                                <option value="10">10 per halaman</option>
                                <option value="20">20 per halaman</option>
                                <option value="50">50 per halaman</option>
                                <option value="all">Semua</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

</div>

<!-- ======================================================= -->
<!-- MODAL DETAIL LENGKAP: 1. TRANSAKSI UANG                 -->
<!-- ======================================================= -->
<div class="modal fade" id="modalTransaksiUang" tabindex="-1" aria-labelledby="modalUangLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header modal-header-custom banner-uang">
                <h5 class="modal-title font-monospace" id="modalUangLabel">
                    💰 Data Lengkap Riwayat Transaksi Uang (<%= Array.isArray(data) ? data.length : 0 %> Data)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle" style="font-size: 0.85rem;">
                        <thead class="table-success">
                            <tr>
                                <th>No</th>
                                <th>Tanggal</th>
                                <th>Kategori</th>
                                <th>Jenis</th>
                                <th>Metode</th>
                                <th>Rekening / Bank</th>
                                <th class="text-end">Nominal</th>
                                <th>Keterangan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (Array.isArray(data) && data.length > 0) { %>
                                <% data.forEach(function(item, idx) { %>
                                    <tr>
                                        <td><%= idx + 1 %></td>
                                        <td><%= new Date(item.tanggal).toLocaleDateString('id-ID', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                                        <td><%= item.kategori_nama || '-' %></td>
                                        <td>
                                            <% if (item.jenis === 'masuk') { %>
                                                <span class="badge bg-success">Pemasukan</span>
                                            <% } else { %>
                                                <span class="badge bg-danger">Pengeluaran</span>
                                            <% } %>
                                        </td>
                                        <td><%= String(item.metode || '').toUpperCase() %></td>
                                        <td>
                                            <% if (item.bank) { %>
                                                <%= item.bank %> (<%= item.no_rekening || '-' %>)
                                            <% } else { %>
                                                -
                                            <% } %>
                                        </td>
                                        <td class="text-end fw-bold <%= item.jenis === 'masuk' ? 'text-success' : 'text-danger' %>">
                                            <%= item.jenis === 'masuk' ? '+' : '-' %> Rp <%= Number(item.nominal || 0).toLocaleString('id-ID') %>
                                        </td>
                                        <td><%= item.keterangan || '-' %></td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-3">Tidak ada data transaksi.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light" style="border-radius: 0 0 16px 16px;">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

