<%- include("partials/header", { title: "Master Kategori — DKM Crystal" }) %>
<%- include("partials/navbar") %>

<div class="container-fluid px-3 px-lg-4 py-3">
    <!-- PAGE HEADER -->
    <div class="admin-page-header mb-4">
        <div>
            <h1 class="admin-page-title fs-3 fw-bold mb-1 text-dark">
                <i class="bi bi-tags text-success"></i> Master Kategori
            </h1>
            <div class="admin-page-subtitle text-muted small">
                <span>Kelola klasifikasi untuk Transaksi Keuangan, Donasi Barang Warga, dan Inventaris Aset</span>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-2 mt-md-0">
            <a href="/transaksi" class="btn btn-outline-success btn-sm">
                <i class="bi bi-cash-stack"></i> Transaksi
            </a>
            <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- NOTIFIKASI ALERT -->
    <% if (status === 'sukses_tambah') { %>
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div><strong>Berhasil!</strong> Kategori baru telah ditambahkan ke database.</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } else if (status === 'sukses_edit') { %>
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div><strong>Berhasil!</strong> Data kategori berhasil diperbarui.</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } else if (status === 'sukses_hapus') { %>
        <div class="alert alert-info alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-info-circle-fill me-2 fs-5"></i>
            <div>Kategori telah dihapus dari database.</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div><strong>Gagal:</strong> <%= error %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <div class="row g-4">
        <!-- FORM TAMBAH KATEGORI -->
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-success text-white py-3" style="border-radius: 16px 16px 0 0;">
                    <h5 class="mb-0 fw-bold fs-6"><i class="bi bi-plus-circle me-1"></i> Tambah Kategori Baru</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <form action="/kategori/simpan" method="POST">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Nama Kategori <span class="text-danger">*</span></label>
                            <input
                                type="text"
                                class="form-control"
                                name="nama"
                                placeholder="Contoh: Operasional Kebersihan"
                                required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Jenis Penggunaan <span class="text-danger">*</span></label>
                            <select id="tipe" class="form-select" name="tipe" required>
                                <option value="">-- Pilih Jenis --</option>
                                <option value="uang">💰 Transaksi Keuangan</option>
                                <option value="donasi">🎁 Donasi Barang Warga</option>
                                <option value="inventaris">📦 Inventaris Sarana/Aset</option>
                            </select>
                            <div class="form-text small">Tentukan di mana kategori ini akan muncul saat penginputan.</div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
                            <i class="bi bi-save2 me-1"></i> Simpan Kategori
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- DAFTAR KATEGORI & FILTER -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <!-- FILTER TABS & SEARCH -->
                <div class="card-header bg-white py-3 border-bottom" style="border-radius: 16px 16px 0 0;">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h5 class="mb-0 fw-bold fs-6 text-dark">
                            <i class="bi bi-list-check text-primary me-2"></i>Daftar Master Kategori
                        </h5>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                            <%= (data && data.length) ? data.length : 0 %> Kategori Ditampilkan
                        </span>
                    </div>

                    <!-- 4 FILTER TABS -->
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <a href="/kategori?tipe=all<%= filterQ ? '&q=' + encodeURIComponent(filterQ) : '' %>"
                           class="btn btn-sm <%= filterTipe === 'all' ? 'btn-success fw-bold' : 'btn-outline-secondary' %> rounded-pill px-3">
                            <i class="bi bi-grid-fill me-1"></i> Semua Kategori
                            <span class="badge <%= filterTipe === 'all' ? 'bg-white text-success' : 'bg-secondary' %> ms-1">
                                <%= counts ? counts.semua : 0 %>
                            </span>
                        </a>

                        <a href="/kategori?tipe=uang<%= filterQ ? '&q=' + encodeURIComponent(filterQ) : '' %>"
                           class="btn btn-sm <%= filterTipe === 'uang' ? 'btn-success fw-bold' : 'btn-outline-secondary' %> rounded-pill px-3">
                            <i class="bi bi-cash-coin me-1"></i> Transaksi Keuangan
                            <span class="badge <%= filterTipe === 'uang' ? 'bg-white text-success' : 'bg-secondary' %> ms-1">
                                <%= counts ? counts.uang : 0 %>
                            </span>
                        </a>

                        <a href="/kategori?tipe=donasi<%= filterQ ? '&q=' + encodeURIComponent(filterQ) : '' %>"
                           class="btn btn-sm <%= filterTipe === 'donasi' ? 'btn-success fw-bold' : 'btn-outline-secondary' %> rounded-pill px-3">
                            <i class="bi bi-gift me-1"></i> Donasi Barang Warga
                            <span class="badge <%= filterTipe === 'donasi' ? 'bg-white text-success' : 'bg-secondary' %> ms-1">
                                <%= counts ? counts.donasi : 0 %>
                            </span>
                        </a>

                        <a href="/kategori?tipe=inventaris<%= filterQ ? '&q=' + encodeURIComponent(filterQ) : '' %>"
                           class="btn btn-sm <%= filterTipe === 'inventaris' ? 'btn-success fw-bold' : 'btn-outline-secondary' %> rounded-pill px-3">
                            <i class="bi bi-box-seam me-1"></i> Inventaris Sarana/Aset
                            <span class="badge <%= filterTipe === 'inventaris' ? 'bg-white text-success' : 'bg-secondary' %> ms-1">
                                <%= counts ? counts.inventaris : 0 %>
                            </span>
                        </a>
                    </div>

                    <!-- SEARCH FORM -->
                    <form action="/kategori" method="GET" class="row g-2">
                        <% if (filterTipe !== 'all') { %>
                            <input type="hidden" name="tipe" value="<%= filterTipe %>">
                        <% } %>
                        <div class="col-12 col-sm-8 col-md-9">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" name="q" class="form-control border-start-0" placeholder="Cari nama kategori..." value="<%= filterQ || '' %>">
                            </div>
                        </div>
                        <div class="col-12 col-sm-4 col-md-3 d-flex gap-1">
                            <button type="submit" class="btn btn-sm btn-outline-success w-100">
                                Cari
                            </button>
                            <% if (filterQ) { %>
                                <a href="/kategori?tipe=<%= filterTipe %>" class="btn btn-sm btn-outline-secondary" title="Reset Pencarian">
                                    <i class="bi bi-x"></i>
                                </a>
                            <% } %>
                        </div>
                    </form>
                </div>

                <!-- TABLE CONTENT -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-muted text-uppercase">
                                <th style="width: 50px;" class="text-center">No</th>
                                <th>Nama Kategori</th>
                                <th style="width: 220px;">Jenis Klasifikasi</th>
                                <th style="width: 140px;" class="text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (data && data.length > 0) { %>
                                <% data.forEach(function(item, index) { %>
                                <tr>
                                    <td class="text-center text-muted fw-semibold small"><%= index + 1 %></td>
                                    <td>
                                        <strong class="text-dark"><%= item.nama %></strong>
                                    </td>
                                    <td>
                                        <% if (item.tipe === "uang") { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                                                <i class="bi bi-cash-coin me-1"></i> Transaksi Keuangan
                                            </span>
                                        <% } else if (item.tipe === "donasi") { %>
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-semibold">
                                                <i class="bi bi-gift me-1"></i> Donasi Barang Warga
                                            </span>
                                        <% } else if (item.tipe === "inventaris") { %>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">
                                                <i class="bi bi-box-seam me-1"></i> Inventaris Sarana/Aset
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">
                                                Belum Ditentukan
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-outline-primary btn-sm py-1 px-2"
                                                    onclick="bukaModalEdit('<%= item.id %>', '<%= encodeURIComponent(item.nama) %>', '<%= item.tipe %>')"
                                                    title="Edit Kategori">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </button>
                                            <a href="/kategori/hapus/<%= item.id %>" class="btn btn-outline-danger btn-sm py-1 px-2"
                                               onclick="return confirm('Hapus kategori <%= item.nama %>?')" title="Hapus Kategori">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                        Tidak ada kategori yang cocok dengan filter yang dipilih.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL EDIT KATEGORI -->
<div class="modal fade" id="modalEditKategori" tabindex="-1" aria-labelledby="modalEditKategoriLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white py-3" style="border-radius: 16px 16px 0 0;">
                <h5 class="modal-title fs-6 fw-bold" id="modalEditKategoriLabel">
                    <i class="bi bi-pencil-square me-2"></i>Edit Data Kategori
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formEditKategori" method="POST" action="">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Nama Kategori <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editNama" name="nama" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Jenis Penggunaan <span class="text-danger">*</span></label>
                        <select class="form-select" id="editTipe" name="tipe" required>
                            <option value="uang">💰 Transaksi Keuangan</option>
                            <option value="donasi">🎁 Donasi Barang Warga</option>
                            <option value="inventaris">📦 Inventaris Sarana/Aset</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-sm btn-primary px-3 fw-semibold">
                        <i class="bi bi-save me-1"></i> Simpan Perubahan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function bukaModalEdit(id, encodedNama, tipe) {
    const nama = decodeURIComponent(encodedNama);
    document.getElementById("formEditKategori").action = "/kategori/edit/" + id;
    document.getElementById("editNama").value = nama;
    document.getElementById("editTipe").value = tipe;
    const modal = new bootstrap.Modal(document.getElementById("modalEditKategori"));
    modal.show();
}
</script>

<%- include("partials/footer") %>
