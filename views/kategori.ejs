<%- include("partials/header", { title: "Master Kategori — DKM Crystal" }) %>
<%- include("partials/navbar") %>

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">
            <i class="bi bi-tags text-success"></i> Master Kategori
        </h1>
        <div class="admin-page-subtitle">
            <span>Kategori Transaksi Keuangan &bull; Donasi Barang &bull; Inventaris Aset</span>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="/transaksi" class="btn btn-outline-success btn-sm">
            <i class="bi bi-cash-stack"></i> Transaksi
        </a>
        <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- FORM TAMBAH KATEGORI -->
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-success text-white py-3" style="border-radius: 16px 16px 0 0;">
                <h5 class="mb-0 fw-bold fs-6"><i class="bi bi-plus-circle me-1"></i> Tambah Kategori Baru</h5>
            </div>
            <div class="card-body p-3 p-md-4">
                <form action="/kategori/simpan" method="POST">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Nama Kategori <span class="text-danger">*</span></label>
                        <input
                            type="text"
                            class="form-control"
                            name="nama"
                            placeholder="Contoh: Operasional Kebersihan"
                            required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Jenis Klasifikasi <span class="text-danger">*</span></label>
                        <select id="tipe" class="form-select" name="tipe" required>
                            <option value="">-- Pilih Jenis --</option>
                            <option value="uang">💰 Transaksi Keuangan</option>
                            <option value="donasi">🎁 Donasi Barang Warga</option>
                            <option value="inventaris">📦 Inventaris Sarana/Aset</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
                        <i class="bi bi-save2 me-1"></i> Simpan Kategori
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- DAFTAR KATEGORI -->
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom" style="border-radius: 16px 16px 0 0;">
                <h5 class="mb-0 fw-bold fs-6 text-dark"><i class="bi bi-list-check text-primary me-2"></i>Daftar Master Kategori</h5>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <%= (data && data.length) ? data.length : 0 %> Kategori
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th style="width: 50px;" class="text-center">No</th>
                            <th>Nama Kategori</th>
                            <th style="width: 220px;">Jenis Klasifikasi</th>
                            <th style="width: 120px;" class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data && data.length > 0) { %>
                            <% data.forEach(function(item, index) { %>
                            <tr>
                                <td class="text-center text-muted fw-semibold small"><%= index + 1 %></td>
                                <td>
                                    <strong class="text-dark"><%= item.nama %></strong>
                                </td>
                                <td>
                                    <% if (item.tipe === "uang") { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                                            <i class="bi bi-cash-coin me-1"></i> Transaksi Uang
                                        </span>
                                    <% } else if (item.tipe === "donasi") { %>
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-semibold">
                                            <i class="bi bi-gift me-1"></i> Donasi Barang
                                        </span>
                                    <% } else if (item.tipe === "inventaris") { %>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">
                                            <i class="bi bi-box-seam me-1"></i> Inventaris
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-secondary">
                                            Belum Ditentukan
                                        </span>
                                    <% } %>
                                </td>
                                <td class="text-center">
                                    <a href="/kategori/hapus/<%= item.id %>" class="btn btn-outline-danger btn-sm" onclick="return confirm('Hapus kategori <%= item.nama %>?')" title="Hapus Kategori">
                                        <i class="bi bi-trash"></i> Hapus
                                    </a>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                    Belum ada kategori yang tersimpan.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include("partials/footer") %>
