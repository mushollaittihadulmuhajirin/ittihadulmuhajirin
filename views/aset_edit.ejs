<%- include("partials/header", { title: "Edit Inventaris Masjid — DKM Crystal" }) %>
<%- include("partials/navbar") %>

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">
            <i class="bi bi-pencil-square text-warning"></i> Edit Inventaris Masjid
        </h1>
        <div class="admin-page-subtitle">
            <span>Perbarui data sarana, prasarana, atau aset fisik DKM Crystal</span>
        </div>
    </div>
    <div>
        <a href="<%= typeof backUrl !== 'undefined' ? backUrl : '/transaksi' %>" class="admin-btn admin-btn-secondary">
            <i class="bi bi-arrow-left"></i> Kembali
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="admin-card">
            <div class="admin-card-header bg-dark text-white">
                <h5><i class="bi bi-box-seam text-warning"></i> Formulir Perubahan Aset #<%= data.id %>: <%= data.nama_aset %></h5>
            </div>
            <div class="admin-card-body p-4">
                <form action="<%= typeof actionUrl !== 'undefined' ? actionUrl : ('/transaksi/update-inventaris/' + data.id) %>" method="POST">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="admin-form-label">Tanggal Masuk <span class="text-danger">*</span></label>
                            <input
                                type="date"
                                name="tanggal_masuk"
                                class="admin-form-control"
                                value="<%= data.tanggal_masuk ? new Date(data.tanggal_masuk).toISOString().slice(0,10) : '' %>"
                                required>
                        </div>

                        <div class="col-md-8">
                            <label class="admin-form-label">Nama Barang / Aset <span class="text-danger">*</span></label>
                            <input
                                type="text"
                                name="nama_aset"
                                class="admin-form-control"
                                value="<%= data.nama_aset %>"
                                required>
                        </div>

                        <div class="col-md-6">
                            <label class="admin-form-label">Kategori Inventaris</label>
                            <select name="kategori" class="admin-form-select">
                                <% kategori.forEach(function(k) { %>
                                    <option value="<%= k.nama %>" <%= data.kategori == k.nama ? "selected" : "" %>>
                                        <%= k.nama %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="admin-form-label">Jumlah / Qty</label>
                            <input
                                type="number"
                                name="jumlah"
                                class="admin-form-control font-monospace"
                                value="<%= data.jumlah %>">
                        </div>

                        <div class="col-md-3">
                            <label class="admin-form-label">Satuan</label>
                            <input
                                type="text"
                                name="satuan"
                                class="admin-form-control"
                                placeholder="Unit, Buah, Set"
                                value="<%= data.satuan %>">
                        </div>

                        <div class="col-md-4">
                            <label class="admin-form-label">Kondisi Barang</label>
                            <select name="kondisi" class="admin-form-select">
                                <option value="baru" <%= (data.kondisi || "").toLowerCase() == "baru" ? "selected" : "" %>>Baru</option>
                                <option value="bekas" <%= (data.kondisi || "").toLowerCase() == "bekas" ? "selected" : "" %>>Bekas</option>
                                <option value="service" <%= (data.kondisi || "").toLowerCase() == "service" ? "selected" : "" %>>Service / Perbaikan</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="admin-form-label">Lokasi Penempatan</label>
                            <input
                                type="text"
                                name="lokasi"
                                class="admin-form-control"
                                placeholder="Gudang, Ruang Utama, Kantor"
                                value="<%= data.lokasi %>">
                        </div>

                        <div class="col-md-4">
                            <label class="admin-form-label">Nilai Estimasi (Rp)</label>
                            <input
                                type="number"
                                name="nilai_estimasi"
                                class="admin-form-control font-monospace"
                                value="<%= data.nilai_estimasi %>">
                        </div>

                        <div class="col-12">
                            <label class="admin-form-label">Keterangan / Spesifikasi</label>
                            <textarea
                                name="keterangan"
                                class="admin-form-control"
                                rows="3"
                                placeholder="Catatan kondisi, merk, serial number, atau detail lainnya"><%= data.keterangan %></textarea>
                        </div>

                        <div class="col-12 d-flex justify-content-between pt-2">
                            <a href="<%= typeof backUrl !== 'undefined' ? backUrl : '/transaksi' %>" class="admin-btn admin-btn-secondary">
                                <i class="bi bi-x-circle"></i> Batal
                            </a>
                            <button type="submit" class="admin-btn admin-btn-primary px-4">
                                <i class="bi bi-save2"></i> Simpan Perubahan
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include("partials/footer") %>