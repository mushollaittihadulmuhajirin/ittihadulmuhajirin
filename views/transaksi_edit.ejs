<%- include("partials/header", { title: "Edit Transaksi Keuangan — DKM Crystal" }) %>
<%- include("partials/navbar") %>

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">
            <i class="bi bi-pencil-square text-warning"></i> Edit Transaksi Keuangan
        </h1>
        <div class="admin-page-subtitle">
            <span>Perbarui rincian transaksi kas atau perbankan masjid</span>
        </div>
    </div>
    <div>
        <a href="/transaksi" class="admin-btn admin-btn-secondary">
            <i class="bi bi-arrow-left"></i> Kembali ke Transaksi
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header bg-dark text-white">
                <h5><i class="bi bi-cash-stack text-warning"></i> Formulir Perubahan Transaksi #<%= data.id %></h5>
            </div>
            <div class="admin-card-body p-4">
                <form action="/transaksi/update/<%= data.id %>" method="POST">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="admin-form-label">Tanggal Transaksi <span class="text-danger">*</span></label>
                            <input
                                type="date"
                                name="tanggal"
                                class="admin-form-control"
                                value="<%= new Date(data.tanggal).toISOString().slice(0,10) %>"
                                required>
                        </div>

                        <div class="col-md-4">
                            <label class="admin-form-label">Jenis Arus Kas <span class="text-danger">*</span></label>
                            <select name="jenis" class="admin-form-select">
                                <option value="masuk" <%= data.jenis === "masuk" ? "selected" : "" %>>
                                    🟢 Pemasukan Kas
                                </option>
                                <option value="keluar" <%= data.jenis === "keluar" ? "selected" : "" %>>
                                    🔴 Pengeluaran Kas
                                </option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="admin-form-label">Metode Pembayaran <span class="text-danger">*</span></label>
                            <select name="metode" id="metode" class="admin-form-select">
                                <option value="tunai" <%= data.metode === "tunai" ? "selected" : "" %>>
                                    💵 Tunai (Kas Fisik)
                                </option>
                                <option value="transfer" <%= data.metode === "transfer" ? "selected" : "" %>>
                                    🏦 Non Tunai (Transfer / QRIS)
                                </option>
                            </select>
                        </div>

                        <div class="col-md-6" id="rekeningGroup">
                            <label class="admin-form-label">Rekening Bank Tujuan</label>
                            <select name="rekening_id" id="rekening_id" class="admin-form-select">
                                <option value="">-- Pilih Rekening --</option>
                                <% rekening.forEach(function(r) { %>
                                    <option value="<%= r.id %>" <%= data.rekening_id == r.id ? "selected" : "" %>>
                                        <%= r.bank %> - <%= r.nama_pemilik %> (<%= r.no_rekening %>)
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="admin-form-label">Kategori Anggaran <span class="text-danger">*</span></label>
                            <select name="kategori_id" class="admin-form-select" required>
                                <% kategori.forEach(function(k) { %>
                                    <option value="<%= k.id %>" <%= data.kategori_id == k.id ? "selected" : "" %>>
                                        <%= k.nama %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="admin-form-label">Nominal Transaksi (Rp) <span class="text-danger">*</span></label>
                            <input
                                type="number"
                                name="nominal"
                                class="admin-form-control font-monospace fs-5 fw-bold"
                                value="<%= data.nominal %>"
                                required>
                        </div>

                        <div class="col-12">
                            <label class="admin-form-label">Keterangan / Uraian Lengkap</label>
                            <textarea
                                name="keterangan"
                                rows="3"
                                class="admin-form-control"
                                placeholder="Tuliskan uraian kebutuhan atau peruntukan transaksi"><%= data.keterangan %></textarea>
                        </div>

                        <div class="col-12 d-flex justify-content-between pt-2">
                            <a href="/transaksi" class="admin-btn admin-btn-secondary">
                                <i class="bi bi-x-circle"></i> Batal
                            </a>
                            <button type="submit" class="admin-btn admin-btn-primary px-4">
                                <i class="bi bi-save2"></i> Simpan Perubahan
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
const metode = document.getElementById("metode");
const rekeningGroup = document.getElementById("rekeningGroup");
const rekening = document.getElementById("rekening_id");

function toggleRekening() {
    if (!metode || !rekeningGroup) return;
    if (metode.value === "tunai") {
        rekeningGroup.style.display = "none";
        if (rekening) rekening.value = "";
    } else {
        rekeningGroup.style.display = "block";
    }
}

toggleRekening();
if (metode) {
    metode.addEventListener("change", toggleRekening);
}
</script>

<%- include("partials/footer") %>