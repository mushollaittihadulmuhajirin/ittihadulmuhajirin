<!-- =============================
5 KARTU RINGKASAN KEUANGAN RESMI
============================== -->

<section class="summary-grid" aria-label="Ringkasan Keuangan Resmi">
    <!-- Kartu 1: Total Masuk -->
    <div class="summary-card">
        <div class="summary-card-inner">
            <div class="summary-icon-circle icon-masuk">
                <i class="bi bi-arrow-up-right"></i>
            </div>
            <div class="summary-info">
                <div class="summary-title">Total Masuk</div>
                <div class="summary-amount amount-masuk" title="Rp <%= formatRpTampilan(pemasukan || 0, false) %>">
                    Rp <%= formatRpTampilan(pemasukan || 0, false) %>
                </div>
                <div class="summary-subtext">Seluruh pemasukan</div>
            </div>
        </div>
    </div>

    <!-- Kartu 2: Total Keluar -->
    <div class="summary-card">
        <div class="summary-card-inner">
            <div class="summary-icon-circle icon-keluar">
                <i class="bi bi-arrow-down-left"></i>
            </div>
            <div class="summary-info">
                <div class="summary-title">Total Keluar</div>
                <div class="summary-amount amount-keluar" title="Rp <%= formatRpTampilan(pengeluaran || 0, false) %>">
                    Rp <%= formatRpTampilan(pengeluaran || 0, false) %>
                </div>
                <div class="summary-subtext">Seluruh pengeluaran</div>
            </div>
        </div>
    </div>

    <!-- Kartu 3: Saldo Total -->
    <div class="summary-card">
        <div class="summary-card-inner">
            <div class="summary-icon-square icon-saldo">
                <i class="bi bi-wallet2"></i>
            </div>
            <div class="summary-info">
                <div class="summary-title">Saldo</div>
                <div class="summary-amount amount-saldo" title="Rp <%= formatRpTampilan(saldoTotal || saldo || 0, false) %>">
                    Rp <%= formatRpTampilan(saldoTotal || saldo || 0, false) %>
                </div>
                <div class="summary-subtext">Masuk - Keluar</div>
            </div>
        </div>
    </div>

    <!-- Kartu 4: Saldo Tunai -->
    <div class="summary-card">
        <div class="summary-card-inner">
            <div class="summary-icon-square icon-tunai">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div class="summary-info">
                <div class="summary-title">Saldo Tunai</div>
                <div class="summary-amount amount-tunai" title="Rp <%= formatRpTampilan(saldoTunai || 0, false) %>">
                    Rp <%= formatRpTampilan(saldoTunai || 0, false) %>
                </div>
                <div class="summary-subtext">Kas &amp; Dompet</div>
            </div>
        </div>
    </div>

    <!-- Kartu 5: Saldo Non-Tunai -->
    <div class="summary-card">
        <div class="summary-card-inner">
            <div class="summary-icon-square icon-nontunai">
                <i class="bi bi-bank"></i>
            </div>
            <div class="summary-info">
                <div class="summary-title">Saldo Non-Tunai</div>
                <div class="summary-amount amount-nontunai" title="Rp <%= formatRpTampilan(saldoNonTunai || 0, true) %>">
                    Rp <%= formatRpTampilan(saldoNonTunai || 0, true) %>
                </div>
                <div class="summary-subtext">Bank Mandiri</div>
            </div>
        </div>
    </div>
</section>



