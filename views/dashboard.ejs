<!-- =============================
CHART SCRIPT
============================== -->

<script>

const ctx = document.getElementById("grafikKeuangan");

new Chart(ctx, {

    type: "bar",

    data: {

        labels: [
            "Pemasukan",
            "Pengeluaran",
            "Saldo"
        ],

        datasets: [{

            label: "Nilai (Rp)",

            data: [
                <%= pemasukan %>,
                <%= pengeluaran %>,
                <%= saldo %>
            ],

            backgroundColor: [
                "#198754",
                "#dc3545",
                "#0d6efd"
            ],

            borderRadius: 10,

            borderSkipped: false

        }]

    },

    options: {

        responsive: true,

        maintainAspectRatio: false,

        plugins: {

            legend: {

                display: false

            },

            tooltip: {

                callbacks: {

                    label: function(context){

                        return "Rp " +
                        Number(context.raw).toLocaleString("id-ID");

                    }

                }

            }

        },

        scales: {

            y: {

                beginAtZero: true,

                ticks: {

                    callback: function(value){

                        return "Rp " +
                        Number(value).toLocaleString("id-ID");

                    }

                }

            }

        }

    }

});

</script>

